' Tests for CastXmlRunner (task 3.0): script building, castxml/vcvars lookup, error codes, and
' (integration) real CastXML runs on the tbfixture header.
Module Tests_Runner
    Public Const MODULE_ID As Long = 2

    Public Sub Register()
        SelfTest.Add "runner: the XML script calls vcvars then castxml with quoted paths, -I and -D", MODULE_ID, 1
        SelfTest.Add "runner: the macro script uses -E -dM -o instead of --castxml-output", MODULE_ID, 2
        SelfTest.Add "runner: castxml lookup order is argument, then CASTXML, then PATH", MODULE_ID, 3
        SelfTest.Add "runner: vcvars32/vcvars64 are found under a VS folder, missing ones give """"", MODULE_ID, 4
        SelfTest.Add "runner: a castxml path that does not exist exits 4 and says so", MODULE_ID, 5
        SelfTest.Add "runner: a missing MSVC install exits 4 and names vcvars", MODULE_ID, 6
        SelfTest.Add "castxml: the fixture header gives x86 and x64 XML and a macro dump", MODULE_ID, 7, True
        SelfTest.Add "castxml: a header with a syntax error fails with castxml's error text", MODULE_ID, 8, True
        SelfTest.Add "runner: with --also, a generated entry file includes the entry header then each extra header (D-033)", MODULE_ID, 9
        SelfTest.Add "castxml: with --also, all passes compile tbblob_entry.h and see the extra header (D-033)", MODULE_ID, 10, True
        SelfTest.Add "runner: QuoteArg doubles backslashes before a quote and escapes quotes, by the C runtime's rules (D-056)", MODULE_ID, 11
        SelfTest.Add "runner: scripts quote -I, -D, -o, castxml and the entry header with QuoteArg; vcvars keeps cmd quoting (D-056)", MODULE_ID, 12
        SelfTest.Add "castxml: a header folder and an -I folder ending in a backslash work (D-056)", MODULE_ID, 13, True
        SelfTest.Add "runner: an error in an --also header traces through tbblob_entry.h to that header (D-057)", MODULE_ID, 14
        SelfTest.Add "runner: an error two includes deep traces to the top-level --also header (D-057)", MODULE_ID, 15
        SelfTest.Add "runner: errors in two headers give both; a warning does not count; a repeated include stack is reused (D-057)", MODULE_ID, 16
        SelfTest.Add "runner: an error in the entry header, in tbblob_entry.h, without a frame or without a file traces to no skippable header (D-057)", MODULE_ID, 17
        SelfTest.Add "runner: warnings alone give no failing header (D-057)", MODULE_ID, 18
        SelfTest.Add "pipeline: the report's 'Headers skipped' lists each header, its pass and CastXML's error lines (D-057)", MODULE_ID, 19
    End Sub

    Public Sub RunTest(ByVal index As Long)
        Select Case index
            Case 1: XmlScript
            Case 2: MacroScript
            Case 3: LookupOrder
            Case 4: VcvarsLookup
            Case 5: MissingCastXmlExits4
            Case 6: MissingMsvcExits4
            Case 7: FixtureRun
            Case 8: BrokenHeaderFails
            Case 9: EntryFile
            Case 10: AlsoRun
            Case 11: QuoteArgRules
            Case 12: ScriptArgQuoting
            Case 13: TrailingBackslashRun
            Case 14: TraceOneHeader
            Case 15: TraceTwoDeep
            Case 16: TraceTwoHeaders
            Case 17: TraceNotSkippable
            Case 18: TraceWarningsOnly
            Case 19: SkippedReport
            Case Else: Err.Raise SelfTest.CHECK_FAILED, , "no test " & index & " in Tests_Runner"
        End Select
    End Sub

    ' ---- helpers ---------------------------------------------------------------

    Private Function Q(ByVal s As String) As String
        Return """" & s & """"
    End Function

    Private Function Coll(ParamArray items() As Variant) As Collection
        Dim c As New Collection, v As Variant
        For Each v In items
            c.Add CStr(v)
        Next
        Return c
    End Function

    Private Sub Touch(ByVal path As String)
        FileSys.MakeDirs FileSys.ParentOf(path)
        FileSys.WriteTextUtf8 path, "x"
    End Sub

    Private Function RepoRoot() As String
        Return FileSys.FullPath(App.Path & "\..")
    End Function

    Private Function FirstElement(ByVal xml As String, ByVal tag As String) As String
        Dim i As Long = InStr(xml, "<" & tag & " ")
        If i = 0 Then Return ""
        Return Mid$(xml, i, InStr(i, xml, ">") - i + 1)
    End Function

    ' ---- unit tests --------------------------------------------------------------

    Private Sub XmlScript()
        Dim s As String = CastXmlRunner.BuildScript("C:\VS (x86)\vcvars32.bat", "C:\cx dir\castxml.exe", "C:\h dir", _
            Coll("C:\inc one", "C:\inc2"), Coll("FOO=1", "BAR"), "C:\h dir\a.h", "C:\w\a_x86.xml", False)
        Dim want As String = "@call " & Q("C:\VS (x86)\vcvars32.bat") & " >nul 2>nul" & vbCrLf & _
            Q("C:\cx dir\castxml.exe") & " --castxml-cc-msvc-c cl --castxml-output=1 -I " & Q("C:\h dir") & _
            " -I " & Q("C:\inc one") & " -I " & Q("C:\inc2") & " -D " & Q("FOO=1") & " -D " & Q("BAR") & _
            " -o " & Q("C:\w\a_x86.xml") & " " & Q("C:\h dir\a.h") & vbCrLf
        SelfTest.AssertEq "script", s, want
    End Sub

    Private Sub MacroScript()
        Dim s As String = CastXmlRunner.BuildScript("C:\vs\vcvars64.bat", "C:\cx\castxml.exe", "C:\h", _
            New Collection, New Collection, "C:\h\a.h", "C:\w\macros.txt", True)
        SelfTest.AssertTrue "uses -E -dM -o", InStr(s, " -E -dM -o " & Q("C:\w\macros.txt") & " ") > 0, s
        SelfTest.AssertTrue "no --castxml-output", InStr(s, "--castxml-output") = 0, s
        SelfTest.AssertTrue "still emulates cl", InStr(s, "--castxml-cc-msvc-c cl") > 0, s
        SelfTest.AssertTrue "no preprocessing without a path", InStr(s, "-std=c11") = 0, s
        ' with a path, the same script also preprocesses the headers, after the dump succeeds (D-060)
        s = CastXmlRunner.BuildScript("C:\vs\vcvars64.bat", "C:\cx\castxml.exe", "C:\h", _
            New Collection, Coll("FOO=1"), "C:\h\a.h", "C:\w\macros.txt", True, "C:\w\pp.i")
        Dim cx As String = Q("C:\cx\castxml.exe") & " --castxml-cc-msvc-c cl"
        Dim want As String = "@call " & Q("C:\vs\vcvars64.bat") & " >nul 2>nul" & vbCrLf & _
            cx & " -E -dM -o " & Q("C:\w\macros.txt") & " -I " & Q("C:\h") & " -D " & Q("FOO=1") & " " & Q("C:\h\a.h") & " || exit /b 1" & vbCrLf & _
            cx & " -E -std=c11 -o " & Q("C:\w\pp.i") & " -I " & Q("C:\h") & " -D " & Q("FOO=1") & " " & Q("C:\h\a.h") & vbCrLf
        SelfTest.AssertEq "script with preprocessing", s, want
    End Sub

    Private Sub LookupOrder()
        Dim t As String = SelfTest.NewTempFolder()
        Dim a As String = t & "\a\castxml.exe"
        Dim b As String = t & "\b\castxml.exe"
        Dim c As String = t & "\c dir\castxml.exe"
        Touch a
        Touch b
        Touch c
        Dim r1 As String = CastXmlRunner.FindCastXmlIn(a, b, "", t & "\nothing;" & t & "\c dir")
        Dim r2 As String = CastXmlRunner.FindCastXmlIn("", b, "", t & "\c dir")
        Dim r3 As String = CastXmlRunner.FindCastXmlIn("", "", "", t & "\nothing;;" & t & "\c dir;")
        Dim r4 As String = CastXmlRunner.FindCastXmlIn("", "", "", t & "\nothing")
        Dim r5 As String = CastXmlRunner.FindCastXmlIn(t & "\missing\castxml.exe", b, "", t & "\c dir")
        Dim r6 As String = CastXmlRunner.FindCastXmlIn("", t & "\missing.exe", "", t & "\c dir")
        FileSys.RemovePath t
        SelfTest.AssertEq "argument wins", r1, a
        SelfTest.AssertEq "then CASTXML", r2, b
        SelfTest.AssertEq "then PATH (empty entries skipped)", r3, c
        SelfTest.AssertEq "nothing found", r4, ""
        SelfTest.AssertEq "a given argument that does not exist is not replaced by a fallback", r5, ""
        SelfTest.AssertEq "a CASTXML that does not exist falls through to PATH", r6, c
    End Sub

    Private Sub VcvarsLookup()
        Dim t As String = SelfTest.NewTempFolder()
        Touch t & "\VC\Auxiliary\Build\vcvars32.bat"
        Dim x86 As String = CastXmlRunner.FindVcvarsIn(t, "x86")
        Dim x64 As String = CastXmlRunner.FindVcvarsIn(t, "x64")
        FileSys.RemovePath t
        SelfTest.AssertEq "x86", x86, t & "\VC\Auxiliary\Build\vcvars32.bat"
        SelfTest.AssertEq "x64 missing", x64, ""
        SelfTest.AssertEq "empty VS path", CastXmlRunner.FindVcvarsIn("", "x86"), ""
    End Sub

    Private Sub MissingCastXmlExits4()
        Dim o As New CliOptions
        o.HeaderFolder = "C:\h"
        o.EntryHeader = "a.h"
        o.CastXmlPath = "C:\no-such-folder\castxml.exe"
        Dim t As String = SelfTest.NewTempFolder()
        Dim r As CastXmlResult = CastXmlRunner.RunCastXml(o, t, "C:\no-such-vs")
        FileSys.RemovePath t
        SelfTest.AssertEq "exit code", r.ExitCode, MainModule.EXIT_TOOL_NOT_FOUND
        SelfTest.AssertTrue "says castxml.exe not found", InStr(r.ErrorText, "castxml.exe not found") > 0, r.ErrorText
    End Sub

    Private Sub MissingMsvcExits4()
        Dim t As String = SelfTest.NewTempFolder()
        Touch t & "\cx\castxml.exe"
        Dim o As New CliOptions
        o.HeaderFolder = "C:\h"
        o.EntryHeader = "a.h"
        o.CastXmlPath = t & "\cx\castxml.exe"
        Dim r As CastXmlResult = CastXmlRunner.RunCastXml(o, t & "\work", t & "\no-such-vs")
        FileSys.RemovePath t
        SelfTest.AssertEq "exit code", r.ExitCode, MainModule.EXIT_TOOL_NOT_FOUND
        SelfTest.AssertTrue "names vcvars", InStr(r.ErrorText, "vcvars") > 0, r.ErrorText
    End Sub

    ' ---- integration tests (real CastXML + MSVC) -------------------------------------

    Private Function RepoCastXml() As String
        Return RepoRoot() & "\CastXML\vcpkg_installed\x64-windows\tools\castxml\bin\castxml.exe"
    End Function

    Private Sub FixtureRun()
        Dim o As New CliOptions
        o.HeaderFolder = RepoRoot() & "\tests\fixture-c"
        o.EntryHeader = "tbfixture.h"
        o.CastXmlPath = RepoCastXml()
        Dim t As String = SelfTest.NewTempFolder()
        Dim work As String = t & "\work folder"
        Dim r As CastXmlResult = CastXmlRunner.RunCastXml(o, work)
        Dim x86 As String, x64 As String, macros As String, macros86 As String, pre As String, scripts As Long
        If r.ExitCode = 0 Then
            x86 = FileSys.ReadTextUtf8(r.Xml86Path)
            x64 = FileSys.ReadTextUtf8(r.Xml64Path)
            macros86 = FileSys.ReadTextUtf8(r.Macros86Path)
            macros = FileSys.ReadTextUtf8(r.Macros64Path)
            pre = FileSys.ReadTextUtf8(r.Preprocessed64Path)
        End If
        If FileSys.KindOf(work & "\castxml_x86.cmd") = FileSys.KIND_FILE Then scripts += 1
        If FileSys.KindOf(work & "\castxml_x64.cmd") = FileSys.KIND_FILE Then scripts += 1
        If FileSys.KindOf(work & "\castxml_macros_x86.cmd") = FileSys.KIND_FILE Then scripts += 1
        If FileSys.KindOf(work & "\castxml_macros_x64.cmd") = FileSys.KIND_FILE Then scripts += 1
        Dim direct As Boolean
        If FileSys.KindOf(work & "\castxml_x86.cmd") = FileSys.KIND_FILE Then direct = InStr(FileSys.ReadTextUtf8(work & "\castxml_x86.cmd"), "tbfixture.h""") > 0 And FileSys.KindOf(work & "\tbblob_entry.h") = FileSys.KIND_NONE
        FileSys.RemovePath t
        SelfTest.AssertEq "exit code", r.ExitCode, 0
        SelfTest.AssertTrue "x86 XML format", InStr(x86, "<CastXML format=""1.") > 0, Left$(x86, 120)
        SelfTest.AssertTrue "x64 XML format", InStr(x64, "<CastXML format=""1.") > 0, Left$(x64, 120)
        SelfTest.AssertTrue "x86 pointers are 32-bit", InStr(FirstElement(x86, "PointerType"), "size=""32""") > 0, FirstElement(x86, "PointerType")
        SelfTest.AssertTrue "x64 pointers are 64-bit", InStr(FirstElement(x64, "PointerType"), "size=""64""") > 0, FirstElement(x64, "PointerType")
        SelfTest.AssertTrue "macro dump has TBF_VERSION_MAJOR", InStr(macros, "#define TBF_VERSION_MAJOR 1") > 0, "length " & Len(macros)
        SelfTest.AssertTrue "x64 macro dump is the x64 compiler's (D-030)", InStr(macros, "#define TBF_ARCH_BITS 64") > 0, "length " & Len(macros)
        SelfTest.AssertTrue "x86 macro dump is the x86 compiler's (D-030)", InStr(macros86, "#define TBF_ARCH_BITS 32") > 0, "length " & Len(macros86)
        SelfTest.AssertTrue "preprocessed headers: SAL expanded away (D-060)", InStr(pre, "typedef int (*tbf_annotated_cb)(") > 0 And InStr(pre, "_Out_writes_bytes_to_") = 0, "length " & Len(pre)
        SelfTest.AssertTrue "preprocessed headers: macro-built parameters expanded", InStr(pre, "typedef int (*tbf_macro_cb)(int first, int second);") > 0, "length " & Len(pre)
        SelfTest.AssertEq "scripts kept in the work folder", scripts, 4
        SelfTest.AssertTrue "without --also the scripts compile the entry header itself", direct
    End Sub

    Private Sub QuoteArgRules()
        SelfTest.AssertEq "plain", Tools.QuoteArg("C:\inc"), Q("C:\inc")
        SelfTest.AssertEq "inner backslashes untouched", Tools.QuoteArg("C:\a b\c"), Q("C:\a b\c")
        SelfTest.AssertEq "trailing backslash doubled", Tools.QuoteArg("C:\inc\"), Q("C:\inc\\")
        SelfTest.AssertEq "drive root", Tools.QuoteArg("C:\"), Q("C:\\")
        SelfTest.AssertEq "two trailing backslashes", Tools.QuoteArg("C:\a\\"), Q("C:\a\\\\")
        SelfTest.AssertEq "embedded quote", Tools.QuoteArg("a""b"), Q("a\""b")
        SelfTest.AssertEq "backslash before a quote", Tools.QuoteArg("a\""b"), Q("a\\\""b")
        SelfTest.AssertEq "empty", Tools.QuoteArg(""), """"""
    End Sub

    ' How often part occurs in s.
    Private Function Occurrences(ByVal s As String, ByVal part As String) As Long
        Return (Len(s) - Len(Replace(s, part, ""))) \ Len(part)
    End Function

    Private Sub ScriptArgQuoting()
        Dim s As String = CastXmlRunner.BuildScript("C:\VS\vcvars64.bat", "C:\cx\castxml.exe", "C:\h\", _
            Coll("D:\"), Coll("ROOT=C:\p\"), "C:\h\a.h", "C:\w\macros.txt", True, "C:\w\pp.i")
        SelfTest.AssertTrue "vcvars keeps cmd quoting", Left$(s, Len("@call " & Q("C:\VS\vcvars64.bat") & " ")) = "@call " & Q("C:\VS\vcvars64.bat") & " ", s
        SelfTest.AssertEq "header folder, on both castxml lines", Occurrences(s, " -I " & Q("C:\h\\") & " "), 2
        SelfTest.AssertEq "drive root -I, on both lines", Occurrences(s, " -I " & Q("D:\\") & " "), 2
        SelfTest.AssertEq "define value, on both lines", Occurrences(s, " -D " & Q("ROOT=C:\p\\") & " "), 2
        Dim x As String = CastXmlRunner.BuildScript("C:\VS\vcvars32.bat", "C:\cx\castxml.exe", "C:\h\", _
            New Collection, New Collection, "C:\h\a.h", "C:\w\a_x86.xml", False)
        SelfTest.AssertTrue "XML script too", InStr(x, " --castxml-output=1 -I " & Q("C:\h\\") & " -o " & Q("C:\w\a_x86.xml") & " " & Q("C:\h\a.h") & vbCrLf) > 0, x
    End Sub

    Private Sub EntryFile()
        Dim extra As New Collection
        extra.Add "C:\h\sys\x.h"
        extra.Add "C:\h\sys\y.h"
        SelfTest.AssertEq "entry file", CastXmlRunner.EntryFileText("C:\h\a.h", extra), _
            "/* GENERATED by tbBlob: the entry header, then each --also header (D-033). */" & vbCrLf & _
            "#include ""C:/h/a.h""" & vbCrLf & "#include ""C:/h/sys/x.h""" & vbCrLf & "#include ""C:/h/sys/y.h""" & vbCrLf
    End Sub

    Private Sub AlsoRun()
        Dim o As New CliOptions
        o.HeaderFolder = RepoRoot() & "\tests\fixture-c"
        o.EntryHeader = "tbfixture.h"
        o.AlsoHeaders.Add "tbfixture_sys.h"
        o.CastXmlPath = RepoCastXml()
        Dim t As String = SelfTest.NewTempFolder()
        Dim r As CastXmlResult = CastXmlRunner.RunCastXml(o, t & "\work")
        Dim x86 As String, script As String, entry As String
        If r.ExitCode = 0 Then x86 = FileSys.ReadTextUtf8(r.Xml86Path)
        If FileSys.KindOf(t & "\work\castxml_x64.cmd") = FileSys.KIND_FILE Then script = FileSys.ReadTextUtf8(t & "\work\castxml_x64.cmd")
        If FileSys.KindOf(t & "\work\tbblob_entry.h") = FileSys.KIND_FILE Then entry = FileSys.ReadTextUtf8(t & "\work\tbblob_entry.h")
        FileSys.RemovePath t
        SelfTest.AssertEq "exit code", r.ExitCode, 0
        SelfTest.AssertTrue "entry file includes the extra header", InStr(entry, "tbfixture_sys.h""") > 0, entry
        SelfTest.AssertTrue "scripts compile the entry file", InStr(script, "tbblob_entry.h""") > 0, script
        SelfTest.AssertTrue "the XML sees the extra header's function", InStr(x86, "name=""tbf_sys_answer""") > 0, "length " & Len(x86)
    End Sub

    Private Sub TrailingBackslashRun()
        Dim o As New CliOptions
        o.HeaderFolder = RepoRoot() & "\tests\fixture-c\"
        o.EntryHeader = "tbfixture.h"
        o.IncludeDirs.Add RepoRoot() & "\tests\fixture-c\"
        o.CastXmlPath = RepoCastXml()
        Dim t As String = SelfTest.NewTempFolder()
        Dim r As CastXmlResult = CastXmlRunner.RunCastXml(o, t & "\work")
        Dim x64 As String, pre As String
        If r.ExitCode = 0 Then
            x64 = FileSys.ReadTextUtf8(r.Xml64Path)
            pre = FileSys.ReadTextUtf8(r.Preprocessed64Path)
        End If
        FileSys.RemovePath t
        SelfTest.AssertTrue "exit code 0", r.ExitCode = 0, "exit " & r.ExitCode & ": " & r.ErrorText
        SelfTest.AssertTrue "x64 XML has the fixture's functions", InStr(x64, "name=""tbf_ret_char""") > 0, "length " & Len(x64)
        SelfTest.AssertTrue "the preprocess line ran too (D-060)", InStr(pre, "tbf_ret_char") > 0, "length " & Len(pre)
    End Sub

    ' ---- D-057: tracing CastXML errors to --also headers ------------------------------------

    Private Const TEST_ENTRY As String = "C:\w\tbblob_entry.h"

    Private Function ErrText(ParamArray lines() As Variant) As String
        Dim v As Variant, s As String
        For Each v In lines
            s &= v & vbCrLf
        Next
        Return s
    End Function

    Private Function Joined(c As Collection) As String
        Dim v As Variant, s As String
        For Each v In c
            s &= v & "|"
        Next
        Return s
    End Function

    Private Function NameList(ByVal names As String) As Collection
        Dim c As New Collection, v As Variant
        For Each v In Split(names, "|")
            c.Add CStr(v)
        Next
        Return c
    End Function

    ' cairo-dwrite.h's shape (D-052, D-059): line 4 of tbblob_entry.h includes the third header.
    Private Sub TraceOneHeader()
        Dim t As String = ErrText("In file included from C:\w\tbblob_entry.h:4:", _
            "C:/inc/cairo/cairo-dwrite.h:65:2: error: DWrite font backend requires C++", _
            "   65 | #error DWrite font backend requires C++", "      |  ^", "1 error generated.")
        Dim names As Collection = NameList("cairo.h|cairo-pdf.h|cairo-dwrite.h")
        SelfTest.AssertEq "header", Joined(CastXmlRunner.FailingHeaders(t, TEST_ENTRY, names)), "cairo-dwrite.h|"
        SelfTest.AssertEq "its error line", Joined(CastXmlRunner.ErrorLinesFor(t, TEST_ENTRY, names, "cairo-dwrite.h")), _
            "C:/inc/cairo/cairo-dwrite.h:65:2: error: DWrite font backend requires C++|"
    End Sub

    Private Sub TraceTwoDeep()
        Dim t As String = ErrText("In file included from C:\w\tbblob_entry.h:3:", _
            "In file included from C:/inc/cairo/cairo-ft.h:45:", _
            "C:/inc/ft2build.h:1:10: fatal error: 'freetype/config/ftheader.h' file not found", "1 error generated.")
        SelfTest.AssertEq "the top-level header", Joined(CastXmlRunner.FailingHeaders(t, TEST_ENTRY, NameList("cairo.h|cairo-ft.h|cairo-dwrite.h"))), "cairo-ft.h|"
    End Sub

    ' The run's real output shape, plus a second error in the same file (clang prints no stack for it).
    Private Sub TraceTwoHeaders()
        Dim t As String = ErrText("In file included from C:\w\tbblob_entry.h:3:", _
            "C:/fx/tbfixture_sys.h:3:12: warning: '/*' within block comment [-Wcomment]", _
            "    3 |  * git2/sys/*.h are not included by git2.h.", "      |            ^", _
            "In file included from C:\w\tbblob_entry.h:4:", _
            "C:/fx/tbfixture_cpp.h:7:2: error: tbfixture_cpp.h requires C++", _
            "    7 | #error tbfixture_cpp.h requires C++", "      |  ^", _
            "C:/fx/tbfixture_cpp.h:9:1: error: a second error in the same file", _
            "In file included from C:\w\tbblob_entry.h:5:", _
            "C:/fx/tbfixture_missing.h:6:10: fatal error: 'tbfixture_no_such_dependency.h' file not found", _
            "1 warning and 3 errors generated.")
        Dim names As Collection = NameList("tbfixture.h|tbfixture_sys.h|tbfixture_cpp.h|tbfixture_missing.h")
        SelfTest.AssertEq "both, not the one with a warning", Joined(CastXmlRunner.FailingHeaders(t, TEST_ENTRY, names)), "tbfixture_cpp.h|tbfixture_missing.h|"
        SelfTest.AssertEq "both errors of the first", CastXmlRunner.ErrorLinesFor(t, TEST_ENTRY, names, "tbfixture_cpp.h").Count, 2
        SelfTest.AssertEq "the fatal error of the second", Joined(CastXmlRunner.ErrorLinesFor(t, TEST_ENTRY, names, "tbfixture_missing.h")), _
            "C:/fx/tbfixture_missing.h:6:10: fatal error: 'tbfixture_no_such_dependency.h' file not found|"
    End Sub

    Private Sub TraceNotSkippable()
        Dim names As Collection = NameList("tbfixture.h|tbfixture_cpp.h")
        Dim inEntry As String = ErrText("In file included from C:\w\tbblob_entry.h:2:", "C:/fx/tbfixture.h:10:1: error: in the entry header")
        SelfTest.AssertEq "the entry header (the caller treats it as fatal)", Joined(CastXmlRunner.FailingHeaders(inEntry, TEST_ENTRY, names)), "tbfixture.h|"
        Dim inEntryFile As String = ErrText("C:\w\tbblob_entry.h:3:10: fatal error: 'x.h' file not found")
        SelfTest.AssertEq "tbblob_entry.h itself", CastXmlRunner.FailingHeaders(inEntryFile, TEST_ENTRY, names).Count, 0
        Dim noFrame As String = ErrText("C:/fx/other.c:1:1: error: no include frame")
        SelfTest.AssertEq "no include frame", CastXmlRunner.FailingHeaders(noFrame, TEST_ENTRY, names).Count, 0
        Dim noFile As String = ErrText("error: no input files")
        SelfTest.AssertEq "CastXML's own error", CastXmlRunner.FailingHeaders(noFile, TEST_ENTRY, names).Count, 0
        Dim mixed As String = ErrText("In file included from C:\w\tbblob_entry.h:3:", "C:/fx/tbfixture_cpp.h:7:2: error: requires C++", "error: no input files")
        SelfTest.AssertEq "one traced and one not: nothing to skip", CastXmlRunner.FailingHeaders(mixed, TEST_ENTRY, names).Count, 0
    End Sub

    Private Sub TraceWarningsOnly()
        Dim t As String = ErrText("In file included from C:\w\tbblob_entry.h:3:", "C:/fx/tbfixture_sys.h:3:12: warning: '/*' within block comment [-Wcomment]", "1 warning generated.")
        SelfTest.AssertEq "nothing", CastXmlRunner.FailingHeaders(t, TEST_ENTRY, NameList("tbfixture.h|tbfixture_sys.h")).Count, 0
    End Sub

    Private Sub SkippedReport()
        Dim s As New SkippedHeader
        s.Header = "tbfixture_cpp.h"
        s.Pass = "x86"
        Set s.ErrorLines = NameList("C:/fx/tbfixture_cpp.h:7:2: error: tbfixture_cpp.h requires C++|C:/fx/tbfixture_cpp.h:9:1: error: another")
        Dim skipped As New Collection
        skipped.Add s
        Dim t As String = SelfTest.NewTempFolder()
        Console.StartCapture
        Dim code As Long = Pipeline.GenerateFrom(SelfTest.Fixture("tbfixture_x86.xml"), SelfTest.Fixture("tbfixture_x64.xml"), SelfTest.Fixture("tbfixture_macros_x86.txt"), _
            SelfTest.Fixture("tbfixture_macros_x64.txt"), SelfTest.Fixture("tbfixture_x64.i"), RepoRoot() & "\tests\fixture-c", Tests_Dlls.Named("tbfixture.dll"), "tbfixture", t & "\out", skipped)
        Dim ignored As String = Console.StopCapture()
        Dim report As String
        If code = 0 Then report = FileSys.ReadTextUtf8(t & "\out\report.md")
        FileSys.RemovePath t
        SelfTest.AssertEq "exit code", code, 0
        SelfTest.AssertTrue "section with the header, its pass and each error line", InStr(report, vbCrLf & "## Headers skipped" & vbCrLf & _
            "- tbfixture_cpp.h (x86 pass): CastXML could not read it, so its functions and types are not generated. CastXML said:" & vbCrLf & _
            "  - C:/fx/tbfixture_cpp.h:7:2: error: tbfixture_cpp.h requires C++" & vbCrLf & _
            "  - C:/fx/tbfixture_cpp.h:9:1: error: another" & vbCrLf) > 0, Left$(report, 800)
    End Sub

    Private Sub BrokenHeaderFails()
        Dim t As String = SelfTest.NewTempFolder()
        FileSys.WriteTextUtf8 t & "\bad.h", "int x = ;" & vbCrLf
        Dim o As New CliOptions
        o.HeaderFolder = t
        o.EntryHeader = "bad.h"
        o.CastXmlPath = RepoCastXml()
        Dim r As CastXmlResult = CastXmlRunner.RunCastXml(o, t & "\work")
        FileSys.RemovePath t
        SelfTest.AssertEq "exit code", r.ExitCode, MainModule.EXIT_FAILED
        SelfTest.AssertTrue "castxml's error text included", InStr(r.ErrorText, "error") > 0, r.ErrorText
        SelfTest.AssertTrue "names the pass", InStr(r.ErrorText, "x86") > 0, r.ErrorText
    End Sub
End Module
