' Tests for CastXmlRunner (task 3.0): script building, castxml/vcvars lookup, error codes, and
' (integration) real CastXML runs on the tbfixture header.
Module Tests_Runner
    Public Const MODULE_ID As Long = 2

    Public Sub Register()
        SelfTest.Add "runner: the XML script calls vcvars then castxml with quoted paths, -I and -D", MODULE_ID, 1
        SelfTest.Add "runner: the macro script uses -E -dM -o instead of --castxml-output", MODULE_ID, 2
        SelfTest.Add "runner: castxml lookup order is argument, then CASTXML, then PATH", MODULE_ID, 3
        SelfTest.Add "runner: vcvars32/vcvars64 are found under a VS folder, missing ones give """"", MODULE_ID, 4
        SelfTest.Add "runner: a castxml path that does not exist exits 4 and says so", MODULE_ID, 5
        SelfTest.Add "runner: a missing MSVC install exits 4 and names vcvars", MODULE_ID, 6
        SelfTest.Add "castxml: the fixture header gives x86 and x64 XML and a macro dump", MODULE_ID, 7, True
        SelfTest.Add "castxml: a header with a syntax error fails with castxml's error text", MODULE_ID, 8, True
        SelfTest.Add "runner: with --also, a generated entry file includes the entry header then each extra header (D-033)", MODULE_ID, 9
        SelfTest.Add "castxml: with --also, all passes compile tbblob_entry.h and see the extra header (D-033)", MODULE_ID, 10, True
    End Sub

    Public Sub RunTest(ByVal index As Long)
        Select Case index
            Case 1: XmlScript
            Case 2: MacroScript
            Case 3: LookupOrder
            Case 4: VcvarsLookup
            Case 5: MissingCastXmlExits4
            Case 6: MissingMsvcExits4
            Case 7: FixtureRun
            Case 8: BrokenHeaderFails
            Case 9: EntryFile
            Case 10: AlsoRun
            Case Else: Err.Raise SelfTest.CHECK_FAILED, , "no test " & index & " in Tests_Runner"
        End Select
    End Sub

    ' ---- helpers ---------------------------------------------------------------

    Private Function Q(ByVal s As String) As String
        Return """" & s & """"
    End Function

    Private Function Coll(ParamArray items() As Variant) As Collection
        Dim c As New Collection, v As Variant
        For Each v In items
            c.Add CStr(v)
        Next
        Return c
    End Function

    Private Sub Touch(ByVal path As String)
        FileSys.MakeDirs FileSys.ParentOf(path)
        FileSys.WriteTextUtf8 path, "x"
    End Sub

    Private Function RepoRoot() As String
        Return FileSys.FullPath(App.Path & "\..")
    End Function

    Private Function FirstElement(ByVal xml As String, ByVal tag As String) As String
        Dim i As Long = InStr(xml, "<" & tag & " ")
        If i = 0 Then Return ""
        Return Mid$(xml, i, InStr(i, xml, ">") - i + 1)
    End Function

    ' ---- unit tests --------------------------------------------------------------

    Private Sub XmlScript()
        Dim s As String = CastXmlRunner.BuildScript("C:\VS (x86)\vcvars32.bat", "C:\cx dir\castxml.exe", "C:\h dir", _
            Coll("C:\inc one", "C:\inc2"), Coll("FOO=1", "BAR"), "C:\h dir\a.h", "C:\w\a_x86.xml", False)
        Dim want As String = "@call " & Q("C:\VS (x86)\vcvars32.bat") & " >nul 2>nul" & vbCrLf & _
            Q("C:\cx dir\castxml.exe") & " --castxml-cc-msvc-c cl --castxml-output=1 -I " & Q("C:\h dir") & _
            " -I " & Q("C:\inc one") & " -I " & Q("C:\inc2") & " -D " & Q("FOO=1") & " -D " & Q("BAR") & _
            " -o " & Q("C:\w\a_x86.xml") & " " & Q("C:\h dir\a.h") & vbCrLf
        SelfTest.AssertEq "script", s, want
    End Sub

    Private Sub MacroScript()
        Dim s As String = CastXmlRunner.BuildScript("C:\vs\vcvars64.bat", "C:\cx\castxml.exe", "C:\h", _
            New Collection, New Collection, "C:\h\a.h", "C:\w\macros.txt", True)
        SelfTest.AssertTrue "uses -E -dM -o", InStr(s, " -E -dM -o " & Q("C:\w\macros.txt") & " ") > 0, s
        SelfTest.AssertTrue "no --castxml-output", InStr(s, "--castxml-output") = 0, s
        SelfTest.AssertTrue "still emulates cl", InStr(s, "--castxml-cc-msvc-c cl") > 0, s
    End Sub

    Private Sub LookupOrder()
        Dim t As String = SelfTest.NewTempFolder()
        Dim a As String = t & "\a\castxml.exe"
        Dim b As String = t & "\b\castxml.exe"
        Dim c As String = t & "\c dir\castxml.exe"
        Touch a
        Touch b
        Touch c
        Dim r1 As String = CastXmlRunner.FindCastXmlIn(a, b, "", t & "\nothing;" & t & "\c dir")
        Dim r2 As String = CastXmlRunner.FindCastXmlIn("", b, "", t & "\c dir")
        Dim r3 As String = CastXmlRunner.FindCastXmlIn("", "", "", t & "\nothing;;" & t & "\c dir;")
        Dim r4 As String = CastXmlRunner.FindCastXmlIn("", "", "", t & "\nothing")
        Dim r5 As String = CastXmlRunner.FindCastXmlIn(t & "\missing\castxml.exe", b, "", t & "\c dir")
        Dim r6 As String = CastXmlRunner.FindCastXmlIn("", t & "\missing.exe", "", t & "\c dir")
        FileSys.RemovePath t
        SelfTest.AssertEq "argument wins", r1, a
        SelfTest.AssertEq "then CASTXML", r2, b
        SelfTest.AssertEq "then PATH (empty entries skipped)", r3, c
        SelfTest.AssertEq "nothing found", r4, ""
        SelfTest.AssertEq "a given argument that does not exist is not replaced by a fallback", r5, ""
        SelfTest.AssertEq "a CASTXML that does not exist falls through to PATH", r6, c
    End Sub

    Private Sub VcvarsLookup()
        Dim t As String = SelfTest.NewTempFolder()
        Touch t & "\VC\Auxiliary\Build\vcvars32.bat"
        Dim x86 As String = CastXmlRunner.FindVcvarsIn(t, "x86")
        Dim x64 As String = CastXmlRunner.FindVcvarsIn(t, "x64")
        FileSys.RemovePath t
        SelfTest.AssertEq "x86", x86, t & "\VC\Auxiliary\Build\vcvars32.bat"
        SelfTest.AssertEq "x64 missing", x64, ""
        SelfTest.AssertEq "empty VS path", CastXmlRunner.FindVcvarsIn("", "x86"), ""
    End Sub

    Private Sub MissingCastXmlExits4()
        Dim o As New CliOptions
        o.HeaderFolder = "C:\h"
        o.EntryHeader = "a.h"
        o.CastXmlPath = "C:\no-such-folder\castxml.exe"
        Dim t As String = SelfTest.NewTempFolder()
        Dim r As CastXmlResult = CastXmlRunner.RunCastXml(o, t, "C:\no-such-vs")
        FileSys.RemovePath t
        SelfTest.AssertEq "exit code", r.ExitCode, MainModule.EXIT_TOOL_NOT_FOUND
        SelfTest.AssertTrue "says castxml.exe not found", InStr(r.ErrorText, "castxml.exe not found") > 0, r.ErrorText
    End Sub

    Private Sub MissingMsvcExits4()
        Dim t As String = SelfTest.NewTempFolder()
        Touch t & "\cx\castxml.exe"
        Dim o As New CliOptions
        o.HeaderFolder = "C:\h"
        o.EntryHeader = "a.h"
        o.CastXmlPath = t & "\cx\castxml.exe"
        Dim r As CastXmlResult = CastXmlRunner.RunCastXml(o, t & "\work", t & "\no-such-vs")
        FileSys.RemovePath t
        SelfTest.AssertEq "exit code", r.ExitCode, MainModule.EXIT_TOOL_NOT_FOUND
        SelfTest.AssertTrue "names vcvars", InStr(r.ErrorText, "vcvars") > 0, r.ErrorText
    End Sub

    ' ---- integration tests (real CastXML + MSVC) -------------------------------------

    Private Function RepoCastXml() As String
        Return RepoRoot() & "\CastXML\vcpkg_installed\x64-windows\tools\castxml\bin\castxml.exe"
    End Function

    Private Sub FixtureRun()
        Dim o As New CliOptions
        o.HeaderFolder = RepoRoot() & "\tests\fixture-c"
        o.EntryHeader = "tbfixture.h"
        o.CastXmlPath = RepoCastXml()
        Dim t As String = SelfTest.NewTempFolder()
        Dim work As String = t & "\work folder"
        Dim r As CastXmlResult = CastXmlRunner.RunCastXml(o, work)
        Dim x86 As String, x64 As String, macros As String, macros86 As String, scripts As Long
        If r.ExitCode = 0 Then
            x86 = FileSys.ReadTextUtf8(r.Xml86Path)
            x64 = FileSys.ReadTextUtf8(r.Xml64Path)
            macros86 = FileSys.ReadTextUtf8(r.Macros86Path)
            macros = FileSys.ReadTextUtf8(r.Macros64Path)
        End If
        If FileSys.KindOf(work & "\castxml_x86.cmd") = FileSys.KIND_FILE Then scripts += 1
        If FileSys.KindOf(work & "\castxml_x64.cmd") = FileSys.KIND_FILE Then scripts += 1
        If FileSys.KindOf(work & "\castxml_macros_x86.cmd") = FileSys.KIND_FILE Then scripts += 1
        If FileSys.KindOf(work & "\castxml_macros_x64.cmd") = FileSys.KIND_FILE Then scripts += 1
        Dim direct As Boolean
        If FileSys.KindOf(work & "\castxml_x86.cmd") = FileSys.KIND_FILE Then direct = InStr(FileSys.ReadTextUtf8(work & "\castxml_x86.cmd"), "tbfixture.h""") > 0 And FileSys.KindOf(work & "\tbblob_entry.h") = FileSys.KIND_NONE
        FileSys.RemovePath t
        SelfTest.AssertEq "exit code", r.ExitCode, 0
        SelfTest.AssertTrue "x86 XML format", InStr(x86, "<CastXML format=""1.") > 0, Left$(x86, 120)
        SelfTest.AssertTrue "x64 XML format", InStr(x64, "<CastXML format=""1.") > 0, Left$(x64, 120)
        SelfTest.AssertTrue "x86 pointers are 32-bit", InStr(FirstElement(x86, "PointerType"), "size=""32""") > 0, FirstElement(x86, "PointerType")
        SelfTest.AssertTrue "x64 pointers are 64-bit", InStr(FirstElement(x64, "PointerType"), "size=""64""") > 0, FirstElement(x64, "PointerType")
        SelfTest.AssertTrue "macro dump has TBF_VERSION_MAJOR", InStr(macros, "#define TBF_VERSION_MAJOR 1") > 0, "length " & Len(macros)
        SelfTest.AssertTrue "x64 macro dump is the x64 compiler's (D-030)", InStr(macros, "#define TBF_ARCH_BITS 64") > 0, "length " & Len(macros)
        SelfTest.AssertTrue "x86 macro dump is the x86 compiler's (D-030)", InStr(macros86, "#define TBF_ARCH_BITS 32") > 0, "length " & Len(macros86)
        SelfTest.AssertEq "scripts kept in the work folder", scripts, 4
        SelfTest.AssertTrue "without --also the scripts compile the entry header itself", direct
    End Sub

    Private Sub EntryFile()
        Dim extra As New Collection
        extra.Add "C:\h\sys\x.h"
        extra.Add "C:\h\sys\y.h"
        SelfTest.AssertEq "entry file", CastXmlRunner.EntryFileText("C:\h\a.h", extra), _
            "/* GENERATED by tbBlob: the entry header, then each --also header (D-033). */" & vbCrLf & _
            "#include ""C:/h/a.h""" & vbCrLf & "#include ""C:/h/sys/x.h""" & vbCrLf & "#include ""C:/h/sys/y.h""" & vbCrLf
    End Sub

    Private Sub AlsoRun()
        Dim o As New CliOptions
        o.HeaderFolder = RepoRoot() & "\tests\fixture-c"
        o.EntryHeader = "tbfixture.h"
        o.AlsoHeaders.Add "tbfixture_sys.h"
        o.CastXmlPath = RepoCastXml()
        Dim t As String = SelfTest.NewTempFolder()
        Dim r As CastXmlResult = CastXmlRunner.RunCastXml(o, t & "\work")
        Dim x86 As String, script As String, entry As String
        If r.ExitCode = 0 Then x86 = FileSys.ReadTextUtf8(r.Xml86Path)
        If FileSys.KindOf(t & "\work\castxml_x64.cmd") = FileSys.KIND_FILE Then script = FileSys.ReadTextUtf8(t & "\work\castxml_x64.cmd")
        If FileSys.KindOf(t & "\work\tbblob_entry.h") = FileSys.KIND_FILE Then entry = FileSys.ReadTextUtf8(t & "\work\tbblob_entry.h")
        FileSys.RemovePath t
        SelfTest.AssertEq "exit code", r.ExitCode, 0
        SelfTest.AssertTrue "entry file includes the extra header", InStr(entry, "tbfixture_sys.h""") > 0, entry
        SelfTest.AssertTrue "scripts compile the entry file", InStr(script, "tbblob_entry.h""") > 0, script
        SelfTest.AssertTrue "the XML sees the extra header's function", InStr(x86, "name=""tbf_sys_answer""") > 0, "length " & Len(x86)
    End Sub

    Private Sub BrokenHeaderFails()
        Dim t As String = SelfTest.NewTempFolder()
        FileSys.WriteTextUtf8 t & "\bad.h", "int x = ;" & vbCrLf
        Dim o As New CliOptions
        o.HeaderFolder = t
        o.EntryHeader = "bad.h"
        o.CastXmlPath = RepoCastXml()
        Dim r As CastXmlResult = CastXmlRunner.RunCastXml(o, t & "\work")
        FileSys.RemovePath t
        SelfTest.AssertEq "exit code", r.ExitCode, MainModule.EXIT_FAILED
        SelfTest.AssertTrue "castxml's error text included", InStr(r.ErrorText, "error") > 0, r.ErrorText
        SelfTest.AssertTrue "names the pass", InStr(r.ErrorText, "x86") > 0, r.ErrorText
    End Sub
End Module
