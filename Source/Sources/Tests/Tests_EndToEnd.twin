' Tests for the whole pipeline and the command line (task 10.0, D-023): output folder layout
' (report.md, Source\, Work\), stage progress, x86/x64 disagreement, determinism, and
' (integration) real runs on tbfixture.h and libgit2.
Module Tests_EndToEnd
    Public Const MODULE_ID As Long = 9

    Public Sub Register()
        SelfTest.Add "pipeline: the output folder gets report.md and Source\ with the fixture's two modules", MODULE_ID, 1
        SelfTest.Add "pipeline: report.md starts with the report title", MODULE_ID, 2
        SelfTest.Add "pipeline: Source\ is emptied before writing", MODULE_ID, 3
        SelfTest.Add "pipeline: an x86/x64 disagreement exits 1, names it, and writes nothing", MODULE_ID, 4
        SelfTest.Add "pipeline: progress lines in stage order, then counts and 'read report.md first'", MODULE_ID, 5
        SelfTest.Add "pipeline: two runs give byte-identical report.md and Source\", MODULE_ID, 6
        SelfTest.Add "cli: a command line with a castxml that does not exist exits 4, writes no Source\ and prints the dependency checklist", MODULE_ID, 7
        SelfTest.Add "end to end: tbBlob on tbfixture.h writes exactly report.md, Source\, Work\; the .twin files import", MODULE_ID, 8, True
        SelfTest.Add "end to end: libgit2 gives 848 declares and the D-011 renames", MODULE_ID, 9, True
        SelfTest.Add "pipeline: a failure while generating names the item, its header and the original error", MODULE_ID, 10
        SelfTest.Add "end to end: --also adds the extra header's module (D-033)", MODULE_ID, 11, True
        SelfTest.Add "end to end: --also headers CastXML cannot read are skipped and reported; the rest is generated as without them; a bad entry header still fails (D-057)", MODULE_ID, 12, True
        SelfTest.Add "end to end: cairo 1.18.4 in one run: both DLLs, counts against the export tables, cairo-dwrite.h skipped, every type defined (D-055)", MODULE_ID, 13, True
    End Sub

    Public Sub RunTest(ByVal index As Long)
        Select Case index
            Case 1: OutputLayout
            Case 2: ReportFirstLine
            Case 3: SourceEmptied
            Case 4: DisagreementStops
            Case 5: ProgressLines
            Case 6: Deterministic
            Case 7: MissingCastXml
            Case 8: FixtureEndToEnd
            Case 9: LibGit2EndToEnd
            Case 10: FailureNamesItem
            Case 11: AlsoEndToEnd
            Case 12: SkipUnreadableHeaders
            Case 13: CairoCounts
            Case Else: Err.Raise SelfTest.CHECK_FAILED, , "no test " & index & " in Tests_EndToEnd"
        End Select
    End Sub

    ' ---- helpers ---------------------------------------------------------------

    Private Function Snap(ByVal file As String) As String
        Return SelfTest.Fixture(file)
    End Function

    ' GenerateFrom on the fixture snapshots into outFolder; console output captured in output.
    Private Function FromSnapshots(ByVal outFolder As String, ByRef output As String) As Long
        Console.StartCapture
        Dim code As Long = Pipeline.GenerateFrom(Snap("tbfixture_x86.xml"), Snap("tbfixture_x64.xml"), Snap("tbfixture_macros_x86.txt"), Snap("tbfixture_macros_x64.txt"), Snap("tbfixture_x64.i"), _
            SelfTest.RepoRoot() & "\tests\fixture-c", Tests_Dlls.Named("tbfixture.dll"), "tbfixture", outFolder)
        output = Console.StopCapture()
        Return code
    End Function

    Private Function Names(ByVal folder As String) As String
        If FileSys.KindOf(folder) <> FileSys.KIND_FOLDER Then Return "(none)"
        Dim n() As String, c As Long, i As Long, s As String
        c = FileSys.ListNames(folder, n)
        If c = 0 Then Return ""
        TextKit.SortOrdinal n, c
        For i = 0 To c - 1
            s &= n(i) & ";"
        Next
        Return s
    End Function

    Private Function RunCli(ByVal joined As String, ByRef output As String) As Long
        Dim args() As String = Split(joined, "|")  ' Split returns a Variant; Run wants a String() ByRef
        Console.StartCapture
        Dim code As Long = MainModule.Run(args)
        output = Console.StopCapture()
        Return code
    End Function

    Private Function RepoCastXml() As String
        Return SelfTest.RepoRoot() & "\CastXML\vcpkg_installed\x64-windows\tools\castxml\bin\castxml.exe"
    End Function

    ' ---- unit tests (snapshots, no CastXML) ------------------------------------------------

    Private Sub OutputLayout()
        Dim t As String = SelfTest.NewTempFolder()
        Dim out As String
        Dim code As Long = FromSnapshots(t & "\out", out)
        Dim top As String = Names(t & "\out")
        Dim src As String = Names(t & "\out\Source")
        FileSys.RemovePath t
        SelfTest.AssertEq "exit code", code, 0
        SelfTest.AssertEq "output folder", top, "Source;report.md;"
        SelfTest.AssertEq "Source", src, "tbfixture.twin;tbfixture_LayoutCheck.twin;tbfixture_Loader.twin;"
    End Sub

    Private Sub ReportFirstLine()
        Dim t As String = SelfTest.NewTempFolder()
        Dim out As String
        FromSnapshots t & "\out", out
        Dim report As String
        If FileSys.KindOf(t & "\out\report.md") = FileSys.KIND_FILE Then report = FileSys.ReadTextUtf8(t & "\out\report.md")
        FileSys.RemovePath t
        SelfTest.AssertEq "title", Split(report, vbCrLf)(0), "# tbBlob generation report: tbfixture"
        SelfTest.AssertTrue "functions counted", InStr(report, vbCrLf & "- functions: 89" & vbCrLf) > 0
    End Sub

    Private Sub SourceEmptied()
        Dim t As String = SelfTest.NewTempFolder()
        FileSys.MakeDirs t & "\out\Source"
        FileSys.WriteTextUtf8 t & "\out\Source\stale.twin", "Module stale" & vbCrLf & "End Module" & vbCrLf
        Dim out As String
        FromSnapshots t & "\out", out
        Dim src As String = Names(t & "\out\Source")
        FileSys.RemovePath t
        SelfTest.AssertEq "stale module gone", src, "tbfixture.twin;tbfixture_LayoutCheck.twin;tbfixture_Loader.twin;"
    End Sub

    Private Sub DisagreementStops()
        Dim t As String = SelfTest.NewTempFolder()
        FileSys.WriteTextUtf8 t & "\macros.txt", ""
        Console.StartCapture
        Dim code As Long = Pipeline.GenerateFrom(SelfTest.RepoRoot() & "\tests\testdata\typemap\disagree_x86.xml", _
            SelfTest.RepoRoot() & "\tests\testdata\typemap\disagree_x64.xml", t & "\macros.txt", t & "\macros.txt", "", "C:\lib\include", Tests_Dlls.Named("s.dll"), "s", t & "\out")
        Dim out As String = Console.StopCapture()
        Dim written As String = Names(t & "\out")
        FileSys.RemovePath t
        SelfTest.AssertEq "exit code", code, MainModule.EXIT_FAILED
        SelfTest.AssertTrue "names the disagreement", InStr(Pipeline.LastError, "S.v") > 0, "LastError=[" & Pipeline.LastError & "]"
        SelfTest.AssertTrue "says it on the console", InStr(out, "S.v") > 0, out
        SelfTest.AssertTrue "nothing written", written = "(none)" Or written = "", "written=[" & written & "]"
    End Sub

    Private Sub ProgressLines()
        Dim t As String = SelfTest.NewTempFolder()
        Dim out As String
        FromSnapshots t & "\out", out
        Dim reportPath As String = FileSys.FullPath(t & "\out") & "\report.md"
        FileSys.RemovePath t
        ' naming needs the macros (constants take part in collision resolution), so macros come first
        Dim stages As Variant = Array("loading CastXML output", "checking x86/x64", "reading macros", "mapping names", "generating", "writing")
        Dim i As Long, at As Long, prev As Long
        For i = 0 To UBound(stages)
            at = InStr(out, stages(i))
            SelfTest.AssertTrue "stage '" & stages(i) & "' after the previous one", at > prev, out
            prev = at
        Next
        SelfTest.AssertTrue "summary counts", InStr(out, "89 functions") > 0, out
        SelfTest.AssertTrue "points at the report", InStr(out, "read " & reportPath & " first") > 0, out
    End Sub

    Private Sub Deterministic()
        Dim t As String = SelfTest.NewTempFolder()
        Dim out As String
        FromSnapshots t & "\a", out
        FromSnapshots t & "\b", out
        Dim same As Boolean = True
        Dim f As Variant
        For Each f In Array("report.md", "Source\tbfixture.twin", "Source\tbfixture_LayoutCheck.twin", "Source\tbfixture_Loader.twin")
            If FileSys.KindOf(t & "\a\" & f) <> FileSys.KIND_FILE Then same = False
            If same Then same = (FileSys.ReadTextUtf8(t & "\a\" & f) = FileSys.ReadTextUtf8(t & "\b\" & f))
        Next
        FileSys.RemovePath t
        SelfTest.AssertTrue "identical", same
    End Sub

    Private Sub MissingCastXml()
        Dim t As String = SelfTest.NewTempFolder()
        Dim out As String
        Dim code As Long = RunCli(SelfTest.RepoRoot() & "\tests\fixture-c|tbfixture.h|tbfixture.dll|" & t & "\out|--castxml|C:\no-such\castxml.exe", out)
        Dim src As String = Names(t & "\out\Source")
        FileSys.RemovePath t
        SelfTest.AssertEq "exit code", code, MainModule.EXIT_TOOL_NOT_FOUND
        SelfTest.AssertTrue "says castxml.exe not found", InStr(out, "castxml.exe not found") > 0, out
        SelfTest.AssertEq "no Source", src, "(none)"
        SelfTest.AssertTrue "then prints the whole checklist, as --check does (D-035)", _
            InStr(out, "MISSING  castxml.exe") > 0 And InStr(out, "MSXML 6") > 0 And InStr(out, "1 missing, 4 not checked because of them") > 0, out
    End Sub

    ' ---- integration (real CastXML; tBImportExport as a test-only check) ----------------------

    Private Sub FixtureEndToEnd()
        Dim t As String = SelfTest.NewTempFolder()
        Dim out As String
        Dim code As Long = RunCli(SelfTest.RepoRoot() & "\tests\fixture-c|tbfixture.h|tbfixture.dll|" & t & "\out|--castxml|" & RepoCastXml(), out)
        Dim top As String = Names(t & "\out")
        Dim src As String = Names(t & "\out\Source")
        Dim work As String = Names(t & "\out\Work")
        Dim importCode As Long = -1
        If code = 0 Then importCode = TestProjects.PackAndImport(t & "\out\Source", "tbfixture", t & "\proj", t & "\tbfixture.twinproj")
        Dim importOutput As String = Tools.LastToolOutput
        FileSys.RemovePath t
        SelfTest.AssertEq "exit code", code, 0
        SelfTest.AssertEq "output folder", top, "Source;Work;report.md;"
        SelfTest.AssertEq "Source", src, "tbfixture.twin;tbfixture_LayoutCheck.twin;tbfixture_Loader.twin;"
        SelfTest.AssertEq "Work", work, "castxml_macros_x64.cmd;castxml_macros_x86.cmd;castxml_x64.cmd;castxml_x64.xml;castxml_x86.cmd;castxml_x86.xml;macros_x64.txt;macros_x86.txt;preprocessed_x64.i;"
        SelfTest.AssertEq "the .twin files import (test-only check)", importCode, 0
    End Sub

    ' Every file in folder with its text, for comparing two Source\ folders.
    Private Function FolderText(ByVal folder As String) As String
        Dim n() As String, c As Long, i As Long, s As String
        If FileSys.KindOf(folder) <> FileSys.KIND_FOLDER Then Return "(none)"
        c = FileSys.ListNames(folder, n)
        TextKit.SortOrdinal n, c
        For i = 0 To c - 1
            s &= "== " & n(i) & vbCrLf & FileSys.ReadTextUtf8(folder & "\" & n(i))
        Next
        Return s
    End Function

    Private Sub SkipUnreadableHeaders()
        Dim root As String = SelfTest.RepoRoot()
        Dim t As String = SelfTest.NewTempFolder()
        Dim common As String = root & "\tests\fixture-c|tbfixture.h|tbfixture.dll|"
        Dim cx As String = "|--castxml|" & RepoCastXml()
        Dim outBad As String, outGood As String, outEntry As String
        Dim codeBad As Long = RunCli(common & t & "\bad" & cx & "|--also|tbfixture_sys.h|--also|tbfixture_cpp.h|--also|tbfixture_missing.h", outBad)
        Dim codeGood As Long = RunCli(common & t & "\good" & cx & "|--also|tbfixture_sys.h", outGood)
        Dim codeEntry As Long = RunCli(root & "\tests\fixture-c|tbfixture_cpp.h|tbfixture.dll|" & t & "\entry" & cx & "|--also|tbfixture_sys.h", outEntry)
        Dim badSource As String = FolderText(t & "\bad\Source")
        Dim goodSource As String = FolderText(t & "\good\Source")
        Dim report As String, work As String
        If codeBad = 0 Then report = FileSys.ReadTextUtf8(t & "\bad\report.md")
        work = Names(t & "\bad\Work")
        FileSys.RemovePath t
        SelfTest.AssertTrue "exit code 0", codeBad = 0, outBad
        SelfTest.AssertTrue "the same Source\ as without the two headers", badSource = goodSource And Len(goodSource) > 1000, "lengths " & Len(badSource) & ", " & Len(goodSource)
        SelfTest.AssertTrue "console warning for the C++-only header", InStr(outBad, "tbBlob: warning: skipped tbfixture_cpp.h: ") > 0 And InStr(outBad, "error: tbfixture_cpp.h requires C++") > 0, outBad
        SelfTest.AssertTrue "console warning for the missing dependency", InStr(outBad, "tbBlob: warning: skipped tbfixture_missing.h: ") > 0, outBad
        SelfTest.AssertTrue "report: the C++-only header", InStr(report, vbCrLf & "- tbfixture_cpp.h (x86 pass): CastXML could not read it") > 0, Left$(report, 1500)
        SelfTest.AssertTrue "report: its error", InStr(report, "error: tbfixture_cpp.h requires C++") > 0, Left$(report, 1500)
        SelfTest.AssertTrue "report: the missing dependency", InStr(report, "fatal error: 'tbfixture_no_such_dependency.h' file not found") > 0, Left$(report, 1500)
        SelfTest.AssertTrue "Work\ keeps the failed pass's output", InStr(work, "castxml_x86_failed.txt;") > 0, work
        SelfTest.AssertEq "a bad entry header fails as before", codeEntry, MainModule.EXIT_FAILED
        SelfTest.AssertTrue "and says why", InStr(outEntry, "requires C++") > 0, outEntry
    End Sub

    Private Sub AlsoEndToEnd()
        Dim t As String = SelfTest.NewTempFolder()
        Dim out As String
        Dim code As Long = RunCli(SelfTest.RepoRoot() & "\tests\fixture-c|tbfixture.h|tbfixture.dll|" & t & "\out|--castxml|" & RepoCastXml() & "|--also|tbfixture_sys.h", out)
        Dim src As String = Names(t & "\out\Source")
        Dim work As String = Names(t & "\out\Work")
        Dim sys As String
        If FileSys.KindOf(t & "\out\Source\tbfixture_sys.twin") = FileSys.KIND_FILE Then sys = FileSys.ReadTextUtf8(t & "\out\Source\tbfixture_sys.twin")
        FileSys.RemovePath t
        SelfTest.AssertEq "exit code", code, 0
        SelfTest.AssertEq "Source", src, "tbfixture.twin;tbfixture_LayoutCheck.twin;tbfixture_Loader.twin;tbfixture_sys.twin;"
        SelfTest.AssertTrue "Work holds the generated entry file", InStr(work, "tbblob_entry.h;") > 0, work
        SelfTest.AssertTrue "the extra header's function", InStr(sys, "Public DeclareWide PtrSafe Function tbf_sys_answer CDecl Lib ""tbfixture.dll"" () As Long") > 0, Left$(sys, 300)
    End Sub

    Private Sub FailureNamesItem()
        Dim t As String = SelfTest.NewTempFolder()
        Dim out As String
        Pipeline.TestFailOn = "tbf_visit_cb"
        Dim code As Long = FromSnapshots(t & "\out", out)
        Pipeline.TestFailOn = ""
        FileSys.RemovePath t
        SelfTest.AssertEq "exit code", code, MainModule.EXIT_FAILED
        SelfTest.AssertTrue "names the item", InStr(Pipeline.LastError, "delegate tbf_visit_cb") > 0, "LastError=[" & Pipeline.LastError & "]"
        SelfTest.AssertTrue "names its header and line", InStr(Pipeline.LastError, "tbfixture.h:") > 0, "LastError=[" & Pipeline.LastError & "]"
        SelfTest.AssertTrue "keeps the original error", InStr(Pipeline.LastError, "forced failure (test hook)") > 0, "LastError=[" & Pipeline.LastError & "]"
        SelfTest.AssertTrue "on the console too", InStr(out, "delegate tbf_visit_cb") > 0, out
    End Sub

    ' ---- cairo (task 29.0, D-055) --------------------------------------------------------

    ' tB's built-in type names, which generated code may use without defining them.
    Private Function IsBuiltinType(ByVal n As String) As Boolean
        Select Case LCase$(n)
            Case "byte", "integer", "long", "longlong", "longptr", "single", "double", "currency", "string", "boolean", "variant", "object", "any", "date", "decimal"
                Return True
        End Select
        Return False
    End Function

    ' The type names used after " As " in text (module qualification and array parentheses
    ' dropped) that text does not define as a Type, Enum, Alias or Delegate and tB does not
    ' build in -- D-052's dangling names. "" when there are none.
    Private Function UndefinedTypes(ByVal text As String) As String
        Dim defined As New Collection, missing As New Collection
        defined.KeyCompareMode = vbTextCompare
        missing.KeyCompareMode = vbTextCompare
        Dim lines() As String = Split(Replace(text, vbCr, ""), vbLf)
        Dim i As Long, s As String, w() As String, k As Long
        For i = 0 To UBound(lines)
            s = Trim$(lines(i))
            w = Split(s, " ")
            For k = 0 To UBound(w) - 1
                Select Case w(k)
                    Case "Type", "Enum", "Alias"
                        If k > 0 Then
                            If w(k - 1) = "Public" Or w(k - 1) = "Private" Then
                                If Not defined.Exists(w(k + 1)) Then defined.Add True, w(k + 1)
                            End If
                        End If
                    Case "Function", "Sub"
                        If k > 0 Then
                            If w(k - 1) = "Delegate" And Not defined.Exists(w(k + 1)) Then defined.Add True, w(k + 1)
                        End If
                End Select
            Next
        Next
        Dim p As Long, j As Long, n As String, code As String, inComment As Boolean
        For i = 0 To UBound(lines)
            ' the code outside /* */ comments (doc comments span lines) and before a ' comment
            s = lines(i)
            code = ""
            Do While Len(s) > 0
                If inComment Then
                    p = InStr(s, "*/")
                    If p = 0 Then Exit Do
                    s = Mid$(s, p + 2)
                    inComment = False
                Else
                    p = InStr(s, "/*")
                    If p = 0 Then
                        code &= s
                        Exit Do
                    End If
                    code &= Left$(s, p - 1)
                    s = Mid$(s, p + 2)
                    inComment = True
                End If
            Loop
            s = code
            If InStr(s, "'") > 0 Then s = Left$(s, InStr(s, "'") - 1)
            p = InStr(s, " As ")
            Do While p > 0
                j = p + 4
                Do While j <= Len(s)
                    If Not (Mid$(s, j, 1) Like "[A-Za-z0-9_.]") Then Exit Do
                    j += 1
                Loop
                n = Mid$(s, p + 4, j - p - 4)
                If InStrRev(n, ".") > 0 Then n = Mid$(n, InStrRev(n, ".") + 1)
                If Len(n) > 0 And Not IsBuiltinType(n) And Not defined.Exists(n) And Not missing.Exists(n) Then missing.Add n, n
                p = InStr(j, s, " As ")
            Loop
        Next
        Dim r As String, v As Variant
        For Each v In missing
            r &= v & " "
        Next
        Return Trim$(r)
    End Function

    ' The lines of a report section, without its heading.
    Private Function Section(ByVal report As String, ByVal title As String) As String
        Dim a As Long = InStr(report, vbCrLf & "## " & title & vbCrLf)
        If a = 0 Then Return "(no section " & title & ")"
        a += Len(vbCrLf & "## " & title & vbCrLf)
        Dim b As Long = InStr(a, report, vbCrLf & "## ")
        If b = 0 Then b = Len(report) + 1
        Dim s As String = Mid$(report, a, b - a)
        Do While Right$(s, 2) = vbCrLf
            s = Left$(s, Len(s) - 2)
        Loop
        Return Trim$(s)
    End Function

    Private Function Occurrences(ByVal s As String, ByVal part As String) As Long
        Return (Len(s) - Len(Replace(s, part, ""))) \ Len(part)
    End Function

    ' The same command line as tests\harness-cairo\build-project.ps1.
    Private Sub CairoCounts()
        Dim x64 As String = SelfTest.RepoRoot() & "\cairo\vcpkg_installed\x64-windows"
        Dim bin86 As String = SelfTest.RepoRoot() & "\cairo\vcpkg_installed_x86\x86-windows\bin"
        SelfTest.AssertTrue "cairo is installed (from cairo\ run: vcpkg install --triplet x64-windows; vcpkg install --triplet x86-windows --x-install-root=vcpkg_installed_x86)", _
            FileSys.KindOf(x64 & "\include\cairo\cairo.h") = FileSys.KIND_FILE And FileSys.KindOf(bin86 & "\cairo-2.dll") = FileSys.KIND_FILE
        Dim t As String = SelfTest.NewTempFolder()
        Dim also As String, h As Variant
        For Each h In Array("cairo-pdf.h", "cairo-ps.h", "cairo-svg.h", "cairo-script.h", "cairo-tee.h", "cairo-win32.h", "cairo-ft.h", "cairo-script-interpreter.h", "cairo-dwrite.h")
            also &= "|--also|" & h
        Next
        Dim out As String
        Dim started As Double = Timer
        Dim code As Long = RunCli(x64 & "\include\cairo|cairo.h|" & x64 & "\bin|" & t & "\out|--castxml|" & RepoCastXml() & "|--x86-dll|" & bin86 & _
            "|-I|" & x64 & "\include|--name|Cairo" & also, out)
        SelfTest.Info "cairo end to end in " & Format$(Timer - started, "0.0") & " s"
        Dim report As String, all As String, files As String, n As Variant
        If code = 0 Then
            report = FileSys.ReadTextUtf8(t & "\out\report.md")
            files = Names(t & "\out\Source")
            For Each n In Split(files, ";")
                If Len(n) > 0 Then all &= FileSys.ReadTextUtf8(t & "\out\Source\" & n) & vbCrLf
            Next
        End If
        FileSys.RemovePath t
        SelfTest.AssertTrue "exit code 0", code = 0, "exit " & code & "; tbBlob said: " & Replace(out, vbLf, " / ")
        SelfTest.AssertEq "declares bound to cairo-2.dll", Occurrences(all, " Lib ""cairo-2.dll"""), 409
        SelfTest.AssertEq "declares bound to cairo-script-interpreter-2.dll", Occurrences(all, " Lib ""cairo-script-interpreter-2.dll"""), 10
        SelfTest.AssertEq "exported but not declared: the 5 dwrite functions and one in no public header", Section(report, "Exported but not declared"), _
            "- cairo-2.dll: cairo_dwrite_font_face_create_for_dwrite_fontface" & vbCrLf & "- cairo-2.dll: cairo_dwrite_font_face_get_measuring_mode" & vbCrLf & _
            "- cairo-2.dll: cairo_dwrite_font_face_get_rendering_params" & vbCrLf & "- cairo-2.dll: cairo_dwrite_font_face_set_measuring_mode" & vbCrLf & _
            "- cairo-2.dll: cairo_dwrite_font_face_set_rendering_params" & vbCrLf & "- cairo-2.dll: cairo_win32_get_system_text_quality"
        SelfTest.AssertEq "declared but not exported: none", Section(report, "Declared but not exported"), "- none"
        Dim skipped As String = Section(report, "Headers skipped")
        SelfTest.AssertTrue "cairo-dwrite.h skipped, the only one", Left$(skipped, 18) = "- cairo-dwrite.h (" And Occurrences(skipped, vbCrLf & "- ") = 0 And InStr(skipped, "DWrite font backend requires C++") > 0, skipped
        SelfTest.AssertEq "no mapping notes", Section(report, "Mapping notes"), "- none"
        SelfTest.AssertEq "no x86/x64 disagreements", Section(report, "x86/x64 disagreements"), "- none"
        SelfTest.AssertEq "every type used is defined (D-052)", UndefinedTypes(all), ""
        For Each n In Array("windef.twin;", "wingdi.twin;", "freetype.twin;", "fontconfig.twin;")
            SelfTest.AssertTrue "outside module " & n, InStr(files, n) > 0, files
        Next
    End Sub

    Private Sub LibGit2EndToEnd()
        Dim t As String = SelfTest.NewTempFolder()
        Dim out As String
        Dim started As Double = Timer
        Dim code As Long = RunCli(SelfTest.RepoRoot() & "\libgit2\vcpkg_installed\x64-windows\include|git2.h|git2.dll|" & t & "\out|--castxml|" & RepoCastXml(), out)
        SelfTest.Info "libgit2 end to end in " & Format$(Timer - started, "0.0") & " s"
        Dim report As String
        If FileSys.KindOf(t & "\out\report.md") = FileSys.KIND_FILE Then report = FileSys.ReadTextUtf8(t & "\out\report.md")
        Dim modules As Long = UBound(Split(Names(t & "\out\Source"), ";"))
        FileSys.RemovePath t
        SelfTest.AssertTrue "exit code 0", code = 0, "exit " & code & "; tbBlob said: " & Replace(out, vbLf, " / ")
        SelfTest.AssertTrue "848 declares", InStr(report, vbCrLf & "- functions: 848" & vbCrLf) > 0, Left$(report, 400)
        SelfTest.AssertTrue "GIT_ERROR renamed, git_error kept", InStr(report, "- enumvalue GIT_ERROR -> GIT_ERROR_ (collides with type git_error)") > 0
        SelfTest.AssertTrue "GIT_REPOSITORY_OPEN_BARE renamed", InStr(report, "- enumvalue GIT_REPOSITORY_OPEN_BARE -> GIT_REPOSITORY_OPEN_BARE_") > 0
        SelfTest.AssertTrue "no x86/x64 disagreements", InStr(report, "## x86/x64 disagreements" & vbCrLf & "- none") > 0
        SelfTest.AssertTrue "one module per header plus layout check", modules > 50, "modules=" & modules
    End Sub
End Module
