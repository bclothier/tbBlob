' Tests for types declared outside the header folder (task 27.0; D-054, D-058, D-064, D-065):
' classification, mapping, module placement, one alias per name, layout and x86/x64 checks, and the
' report. Integration: the Windows SDK's XML is ~8 MB per architecture, too big to commit as a
' snapshot, so one real run of the fixture with --also tbfixture_win.h serves every test (cached),
' and a second with --qualify-outside and --pointer serves task 28.0's.
Module Tests_Outside
    Public Const MODULE_ID As Long = 13

    Private mRun As String          ' the run's temp folder ("" before the first test)
    Private mOutput As String       ' its console output
    Private mCode As Long
    Private mRunQ As String         ' the --qualify-outside --pointer run (task 28.0)
    Private mOutputQ As String
    Private mCodeQ As Long

    Public Sub Register()
        SelfTest.Add "outside: each reached type is classified (struct, enum, handle, opaque, com); nothing unreached is imported", MODULE_ID, 1, True
        SelfTest.Add "outside: signatures and fields map each kind (ByRef struct, by-value struct, handle and FILE aliases, LongPtr /* IStream */)", MODULE_ID, 2, True
        SelfTest.Add "outside: Types and Enums go into header-named modules, aliases to their file scope, each alias name once (D-065)", MODULE_ID, 3, True
        SelfTest.Add "outside: imported records are layout-checked and compared between x86 and x64", MODULE_ID, 4, True
        SelfTest.Add "outside: the report's 'Outside types', 'COM interfaces' and 'Outside structs passed ByRef' sections", MODULE_ID, 5, True
        SelfTest.Add "--qualify-outside: outside Types and Enums are module-qualified wherever used; aliases are not (D-065)", MODULE_ID, 6, True
        SelfTest.Add "--pointer: a T* parameter of that outside struct is ByVal LongPtr; the struct is still imported; the report lists it and an unknown name", MODULE_ID, 7, True
        SelfTest.Add "cli: --qualify-outside and --pointer parse; --pointer repeats", MODULE_ID, 8
    End Sub

    Public Sub RunTest(ByVal index As Long)
        Select Case index
            Case 1: Kinds
            Case 2: Mapping
            Case 3: Placement
            Case 4: LayoutAndArch
            Case 5: ReportSections
            Case 6: Qualified
            Case 7: PointerOption
            Case 8: CliOptionsParse
            Case Else: Err.Raise SelfTest.CHECK_FAILED, , "no test " & index & " in Tests_Outside"
        End Select
    End Sub

    ' ---- helpers ---------------------------------------------------------------

    ' The cached run: tbBlob on the fixture with --also tbfixture_win.h and -I fixture-outside.
    Private Function RunFolder() As String
        If Len(mRun) > 0 Then Return mRun
        mRun = SelfTest.NewTempFolder()
        Dim root As String = SelfTest.RepoRoot()
        Dim args() As String = Split(root & "\tests\fixture-c|tbfixture.h|tbfixture.dll|" & mRun & "\out|--castxml|" & _
            root & "\CastXML\vcpkg_installed\x64-windows\tools\castxml\bin\castxml.exe|--also|tbfixture_win.h|-I|" & root & "\tests\fixture-outside", "|")
        Console.StartCapture
        mCode = MainModule.Run(args)
        mOutput = Console.StopCapture()
        Return mRun
    End Function

    ' The second cached run: the same with --qualify-outside --pointer LOGFONTW --pointer NOPE.
    Private Function RunFolderQ() As String
        If Len(mRunQ) > 0 Then Return mRunQ
        mRunQ = SelfTest.NewTempFolder()
        Dim root As String = SelfTest.RepoRoot()
        Dim args() As String = Split(root & "\tests\fixture-c|tbfixture.h|tbfixture.dll|" & mRunQ & "\out|--castxml|" & _
            root & "\CastXML\vcpkg_installed\x64-windows\tools\castxml\bin\castxml.exe|--also|tbfixture_win.h|-I|" & root & "\tests\fixture-outside" & _
            "|--qualify-outside|--pointer|LOGFONTW|--pointer|NOPE", "|")
        Console.StartCapture
        mCodeQ = MainModule.Run(args)
        mOutputQ = Console.StopCapture()
        Return mRunQ
    End Function

    Private Function Source(ByVal moduleName As String, Optional ByVal qualified As Boolean = False) As String
        Dim path As String = If(qualified, RunFolderQ(), RunFolder()) & "\out\Source\" & moduleName & ".twin"
        If FileSys.KindOf(path) <> FileSys.KIND_FILE Then Return ""
        Return FileSys.ReadTextUtf8(path)
    End Function

    Private Function Mapper(ByVal arch As String) As TypeMapper
        Dim m As New CxModel
        m.Load RunFolder() & "\out\Work\castxml_" & arch & ".xml", SelfTest.RepoRoot() & "\tests\fixture-c"
        Dim t As New TypeMapper
        t.Init m
        Return t
    End Function

    Private Sub RunOk()
        Dim folder As String = RunFolder()
        SelfTest.AssertTrue "the run exits 0", mCode = 0, mOutput
    End Sub

    ' The text contains this exact line (or consecutive lines joined with vbCrLf).
    Private Sub HasLine(ByVal text As String, ByVal what As String, ByVal lineText As String)
        SelfTest.AssertTrue what, InStr(text, vbCrLf & lineText & vbCrLf) > 0, "missing line(s): [" & Replace(lineText, vbCrLf, " \n ") & "]"
    End Sub

    Private Function Occurrences(ByVal s As String, ByVal part As String) As Long
        Return (Len(s) - Len(Replace(s, part, ""))) \ Len(part)
    End Function

    ' ---- tests -----------------------------------------------------------------------

    Private Sub Kinds()
        RunOk
        Dim o As OutsideType, s As String
        For Each o In Mapper("x64").OutsideTypes()
            s &= o.Name & ":" & o.Kind & "|"
        Next
        SelfTest.AssertEq "kinds, in the order reached", s, "tagLOGFONTW:struct|HDC:handle|tagPOINT:struct|tagRECT:struct|HBRUSH:handle|FILE:opaque|" & _
            "IStream:com|OUT_MODE:enum|OUT_RECP:handle|OUT_REC:struct|OUT_INNER:struct|OUT_OPAQUE:opaque|OUT_HOOKS:struct|OUT_HOOK_FN:delegate|OUT_PATH_DATA:struct|"
    End Sub

    Private Sub Mapping()
        RunOk
        Dim t As String = Source("tbfixture_win")
        HasLine t, "T* to an outside struct: ByRef", "        ByRef lf As tagLOGFONTW _"
        HasLine t, "a handle returned", "    Public DeclareWide PtrSafe Function tbw_screen_dc CDecl Lib ""tbfixture.dll"" () As HDC"
        HasLine t, "a handle passed ByVal", "        ByVal dc As HDC _"
        HasLine t, "an outside struct by value, both ways", "        ByVal a As tagPOINT, _" & vbCrLf & "        ByVal b As tagPOINT _" & vbCrLf & "    ) As tagPOINT"
        HasLine t, "FILE* as the FILE alias", "        ByVal f As FILE _"
        HasLine t, "a COM interface pointer (D-058)", "        ByVal s As LongPtr /* IStream */ _"
        HasLine t, "an outside enum", "        ByVal mode As OUT_MODE _"
        HasLine t, "a pointer typedef returned", "    Public DeclareWide PtrSafe Function tbw_rec_get CDecl Lib ""tbfixture.dll"" () As OUT_RECP"
        HasLine t, "an incomplete outside struct", "        ByVal o As OUT_OPAQUE _"
        HasLine t, "an outside struct as a field", "        bounds As tagRECT  ' C: RECT"
        HasLine t, "a handle as a field", "        brush As HBRUSH  ' C: HBRUSH"
    End Sub

    Private Sub Placement()
        RunOk
        Dim windef As String = Source("windef")
        SelfTest.AssertTrue "title without a machine path", Left$(windef, 50) = "' GENERATED by tbBlob from shared/windef.h -- do n", Left$(windef, 80)
        Dim aliasAt As Long = InStr(windef, vbCrLf & "Public Alias HDC As LongPtr" & vbCrLf)
        Dim moduleAt As Long = InStr(windef, vbCrLf & "Module windef" & vbCrLf)
        SelfTest.AssertTrue "the handle alias at file scope, before the module", aliasAt > 0 And aliasAt < moduleAt, "alias " & aliasAt & ", module " & moduleAt
        HasLine windef, "an outside struct in its header's module", "    Public Type tagPOINT"
        HasLine Source("wingdi"), "tagLOGFONTW in wingdi", "    Public Type tagLOGFONTW"
        HasLine Source("corecrt_wstdio"), "FILE in corecrt_wstdio", "Public Alias FILE As LongPtr"
        Dim outlib As String = Source("outlib")
        HasLine outlib, "the outside enum", "    Public Enum OUT_MODE"
        HasLine outlib, "the transitively imported struct", "    Public Type OUT_INNER"
        SelfTest.AssertTrue "an unreached struct is not imported", InStr(outlib, "OUT_UNUSED") = 0
        HasLine outlib, "an outside callback type as a delegate (D-068)", "    Public Delegate Function OUT_HOOK_FN CDecl ( _"
        HasLine outlib, "the delegate as a field", "        hook As OUT_HOOK_FN  ' C: OUT_HOOK_FN"
        HasLine outlib, "an anonymous struct named after its field (D-068)", "    Public Type OUT_PATH_DATA_header"
        HasLine outlib, "the union accessor uses it", "        Public Property Get header() As OUT_PATH_DATA_header"
        Dim all As String, n As Variant
        For Each n In Array("windef", "wingdi", "outlib", "corecrt_wstdio", "tbfixture", "tbfixture_win")
            all &= Source(n)
        Next
        SelfTest.AssertEq "HDC declared once in the whole project (D-065)", Occurrences(all, "Public Alias HDC As "), 1
        SelfTest.AssertTrue "DECLARE_HANDLE's struct is not imported", InStr(all, "Public Type HDC__") = 0
        SelfTest.AssertTrue "no IStream Type or Vtbl", InStr(all, "Public Type IStream") = 0 And InStr(all, "IStreamVtbl") = 0
    End Sub

    Private Sub LayoutAndArch()
        RunOk
        Dim t As String = Source("tbfixture_LayoutCheck")
        SelfTest.AssertTrue "tagLOGFONTW is layout-checked", InStr(t, "Chk ""tagLOGFONTW size"", LenB(v), E(92, 92)") > 0, "length " & Len(t)
        SelfTest.AssertTrue "OUT_REC is layout-checked", InStr(t, """OUT_REC size""") > 0, "length " & Len(t)
        Dim m64 As TypeMapper = Mapper("x64")
        Dim m86 As TypeMapper = Mapper("x86")
        SelfTest.AssertTrue "the x86 twin of an outside record is found", Not m86.FindRecord("tagLOGFONTW") Is Nothing
        SelfTest.AssertTrue "and of an anonymous record (D-068)", Not m86.FindRecord("OUT_PATH_DATA_point") Is Nothing
        SelfTest.AssertTrue "an anonymous record is layout-checked", InStr(t, """OUT_PATH_DATA_point size""") > 0, "length " & Len(t)
        SelfTest.AssertEq "no disagreements", m64.Disagreements(m86).Count, 0
    End Sub

    Private Sub ReportSections()
        RunOk
        Dim r As String = FileSys.ReadTextUtf8(RunFolder() & "\out\report.md")
        HasLine r, "a struct", "- tagLOGFONTW: imported struct (92 bytes on x64), module wingdi (um\wingdi.h)"
        HasLine r, "a handle", "- HDC: handle (DECLARE_HANDLE), LongPtr alias, module windef (shared\windef.h)"
        HasLine r, "FILE", "- FILE: standard pointer-only type (C11 7.21.3), LongPtr alias, module corecrt_wstdio (ucrt\corecrt_wstdio.h)"
        HasLine r, "a pointer typedef", "- OUT_RECP: pointer typedef to OUT_REC (imported), LongPtr alias, module outlib (fixture-outside\outlib.h)"
        HasLine r, "an opaque struct", "- OUT_OPAQUE: opaque (incomplete struct), LongPtr alias, module outlib (fixture-outside\outlib.h)"
        SelfTest.AssertTrue "COM interfaces section with its user", InStr(r, vbCrLf & "## COM interfaces" & vbCrLf & "- IStream (um\objidlbase.h): written LongPtr /* IStream */") > 0 And _
            InStr(r, "Used by: tbw_stream_ok" & vbCrLf) > 0, Mid$(r, InStr(r, "## COM"), 400)
        HasLine r, "an outside struct passed ByRef, a --pointer candidate", "- tbw_font_height(lf): ByRef As tagLOGFONTW (--pointer tagLOGFONTW would pass it as LongPtr)"
        ' the last test of this run: remove it
        FileSys.RemovePath mRun
        mRun = ""
    End Sub

    Private Sub Qualified()
        Dim folder As String = RunFolderQ()
        SelfTest.AssertTrue "the run exits 0", mCodeQ = 0, mOutputQ
        Dim t As String = Source("tbfixture_win", True)
        HasLine t, "by value and return", "        ByVal a As windef.tagPOINT, _" & vbCrLf & "        ByVal b As windef.tagPOINT _" & vbCrLf & "    ) As windef.tagPOINT"
        HasLine t, "a field", "        bounds As windef.tagRECT  ' C: RECT"
        HasLine t, "an enum", "        ByVal mode As outlib.OUT_MODE _"
        HasLine t, "a handle alias stays unqualified", "        ByVal dc As HDC _"
        HasLine t, "FILE stays unqualified", "        ByVal f As FILE _"
        HasLine t, "an alias field stays unqualified", "        brush As HBRUSH  ' C: HBRUSH"
        HasLine Source("outlib", True), "a field of an outside struct, inside its own module", "        inner As outlib.OUT_INNER  ' C: OUT_INNER"
        SelfTest.AssertTrue "library types stay unqualified", InStr(t, "As tbfixture.") = 0 And InStr(t, "As tbfixture_win.") = 0
    End Sub

    Private Sub PointerOption()
        Dim folder As String = RunFolderQ()
        SelfTest.AssertTrue "the run exits 0", mCodeQ = 0, mOutputQ
        Dim t As String = Source("tbfixture_win", True)
        HasLine t, "T* of the --pointer struct is ByVal LongPtr", "    Public DeclareWide PtrSafe Function tbw_font_height CDecl Lib ""tbfixture.dll"" ( _" & vbCrLf & "        ByVal lf As LongPtr _"
        HasLine t, "both uses", "    Public DeclareWide PtrSafe Sub tbw_make_font CDecl Lib ""tbfixture.dll"" ( _" & vbCrLf & "        ByVal out As LongPtr _"
        HasLine Source("wingdi", True), "the struct is still imported", "    Public Type tagLOGFONTW"
        Dim r As String = FileSys.ReadTextUtf8(folder & "\out\report.md")
        HasLine r, "reported", "- tbw_font_height(lf): tagLOGFONTW* as LongPtr (--pointer)"
        HasLine r, "an unknown --pointer name", "- --pointer NOPE: the library uses no outside struct of that name; ignored"
        ' the last test of this run: remove it
        FileSys.RemovePath mRunQ
        mRunQ = ""
    End Sub

    Private Sub CliOptionsParse()
        Dim o As New CliOptions, plain As New CliOptions
        Dim a1() As String = Split("C:\h|a.h|a.dll|C:\o|--qualify-outside|--pointer|LOGFONTW|--pointer|FILE", "|")
        Dim a2() As String = Split("C:\h|a.h|a.dll|C:\o", "|")
        SelfTest.AssertEq "parses", o.Parse(a1), ""
        SelfTest.AssertTrue "--qualify-outside", o.QualifyOutside
        SelfTest.AssertEq "--pointer repeats", o.PointerTypes.Count, 2
        SelfTest.AssertEq "first --pointer", o.PointerTypes(1), "LOGFONTW"
        plain.Parse a2
        SelfTest.AssertTrue "off by default", Not plain.QualifyOutside And plain.PointerTypes.Count = 0
    End Sub
End Module
