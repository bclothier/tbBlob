' TEST-ONLY helpers (D-023): package generated .twin files into a tB project so tests can prove
' they import with tBImportExport. tbBlob itself writes only .twin files and never does this.
' (Moved from ProjectWriter in task 10.1.)
Module TestProjects
    ' 32-bit FNV-1a of the UTF-16 code units of s, started from basis.
    Private Function Fnv32(ByVal s As String, ByVal basis As LongLong) As LongLong
        Dim h As LongLong = basis
        Dim i As Long
        Dim mask As LongLong = CLngLng(4294967295#)
        For i = 1 To Len(s)
            h = (h Xor (AscW(Mid$(s, i, 1)) And &HFFFF&)) And mask
            h = (h * 16777619) And mask
        Next
        Return h
    End Function

    ' A GUID derived only from seed (same seed -> same GUID).
    Public Function DeterministicGuid(ByVal seed As String) As String
        Dim digits As String, k As Long
        For k = 1 To 4
            digits &= Right$("00000000" & Hex$(Fnv32(k & "|" & seed, CLngLng(2166136261#))), 8)
        Next
        Return "{" & Mid$(digits, 1, 8) & "-" & Mid$(digits, 9, 4) & "-" & Mid$(digits, 13, 4) & "-" & Mid$(digits, 17, 4) & "-" & Mid$(digits, 21, 12) & "}"
    End Function

    ' A minimal Settings JSON for a test project (the reference set proven in the spike).
    Public Function SettingsText(ByVal projectName As String) As String
        Dim q As String = """"
        Dim t As String = vbTab
        Dim lines As Variant = Array( _
            "{", _
            t & q & "configuration.inherits" & q & ": " & q & "Defaults" & q & ",", _
            t & q & "project.appTitle" & q & ": " & q & projectName & q & ",", _
            t & q & "project.buildPath" & q & ": " & q & "${SourcePath}\\Build\\${ProjectName}_${Architecture}.${FileExtension}" & q & ",", _
            t & q & "project.buildType" & q & ": " & q & "Standard DLL" & q & ",", _
            t & q & "project.description" & q & ": " & q & "test project for bindings generated by tbBlob" & q & ",", _
            t & q & "project.exportPathIsV2" & q & ": true,", _
            t & q & "project.id" & q & ": " & q & DeterministicGuid(projectName) & q & ",", _
            t & q & "project.name" & q & ": " & q & projectName & q & ",", _
            t & q & "project.optionExplicit" & q & ": true,", _
            t & q & "project.references" & q & ": [", _
            t & t & "{", _
            t & t & t & q & "id" & q & ": " & q & "{00020430-0000-0000-C000-000000000046}" & q & ",", _
            t & t & t & q & "lcid" & q & ": 0,", _
            t & t & t & q & "name" & q & ": " & q & "OLE Automation" & q & ",", _
            t & t & t & q & "path32" & q & ": " & q & "C:\\Windows\\SysWow64\\stdole2.tlb" & q & ",", _
            t & t & t & q & "path64" & q & ": " & q & "C:\\Windows\\System32\\stdole2.tlb" & q & ",", _
            t & t & t & q & "symbolId" & q & ": " & q & "stdole" & q & ",", _
            t & t & t & q & "versionMajor" & q & ": 2,", _
            t & t & t & q & "versionMinor" & q & ": 0", _
            t & t & "}", _
            t & "],", _
            t & q & "project.settingsVersion" & q & ": 1,", _
            t & q & "runtime.useUnicodeStandardLibrary" & q & ": true", _
            "}")
        Return Join(lines, vbCrLf) & vbCrLf
    End Function

    ' Makes folder an import/export layout (Settings, Sources\ with every .twin from sourceFolder,
    ' and the empty standard folders) and imports it into twinproj; returns the tool's exit code.
    Public Function PackAndImport(ByVal sourceFolder As String, ByVal projectName As String, ByVal folder As String, ByVal twinproj As String) As Long
        Dim d As Variant
        For Each d In Array("Sources", "Resources", "Miscellaneous", "ImportedTypeLibraries", "Packages")
            FileSys.MakeDirs folder & "\" & d
        Next
        FileSys.WriteTextUtf8 folder & "\Settings", SettingsText(projectName)
        Dim names() As String, n As Long, i As Long
        n = FileSys.ListNames(sourceFolder, names)
        For i = 0 To n - 1
            If LCase$(Right$(names(i), 5)) = ".twin" Then FileSys.WriteTextUtf8 folder & "\Sources\" & names(i), FileSys.ReadTextUtf8(sourceFolder & "\" & names(i))
        Next
        Return Tools.RunImportTool(twinproj, folder)
    End Function
End Module
