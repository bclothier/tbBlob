' Maps one CastXML model's types to tB (PRD req. 19-25): fields, parameters, returns, unions,
' bitfields, packing and calling conventions. One TypeMapper per architecture; Disagreements
' compares the x86 and x64 mappers (PRD section 7.8). Rules: D-001 (fields), D-003 (pointers),
' D-005 (scalars), D-006 (va_list), D-018 (unions); types declared outside the header folder:
' D-054, D-058, D-065 (OutsideTypes).
Class TypeMapper
    Public Model As CxModel
    Public SynthDelegates As New Collection
    Public Notes As New Collection
    ' What Disagreements is comparing right now, for error messages (errors carry context).
    Public CurrentItem As String
    ' --pointer (D-054): C names (struct tags or typedefs) of outside structs whose T* parameters
    ' are LongPtr; and each place that applied, "function(param): T* as LongPtr (--pointer)".
    Public PointerTypes As New Collection
    Public PointerUses As New Collection
    Private mPointerStructs As Collection   ' struct name -> True (built from PointerTypes)
    Private mPointerUseKeys As Collection

    Private mRecordIndex As Collection      ' record name -> first record of that name (D-038; keyed, D-040)
    Private mFunctionIndex As Collection    ' function name -> first function of that name
    Private mOutside As Collection          ' OutsideType, in the order reached (OutsideTypes)
    Private mOutsideSeen As Collection      ' element id -> True: already walked
    Private mOutsideNames As Collection     ' tB name -> True: each outside name once (D-065)
    Private mAnonRecords As Collection      ' anonymous structs/unions used as a named field's type (D-068)
    Private mAnonSeen As Collection

    Public Sub Init(m As CxModel)
        Set Model = m
        Set mRecordIndex = Nothing
        Set mFunctionIndex = Nothing
        Set mOutside = Nothing
        Set mAnonRecords = Nothing
    End Sub

    ' ---- lookups ---------------------------------------------------------------------
    ' Indexes built on first use; the first record/function of a name wins, as a scan would.

    Public Function FindRecord(ByVal name As String) As MSXML2.IXMLDOMElement
        If mRecordIndex Is Nothing Then
            Set mRecordIndex = New Collection
            mRecordIndex.KeyCompareMode = vbBinaryCompare
            Dim r As MSXML2.IXMLDOMElement, n As String
            For Each r In Model.Records()
                n = Model.NameOf(r)
                If Not mRecordIndex.Exists(n) Then mRecordIndex.Add r, n
            Next
            ' imported outside structs too (D-054), so the x86 twin of one is found by name
            Dim o As OutsideType
            For Each o In OutsideTypes()
                If o.Kind = "struct" And Not mRecordIndex.Exists(o.Name) Then mRecordIndex.Add o.Element, o.Name
            Next
            ' and the anonymous records named after their parent and field (D-068)
            Dim a As MSXML2.IXMLDOMElement
            For Each a In AnonRecords()
                n = RecordName(a)
                If Len(n) > 0 And Not mRecordIndex.Exists(n) Then mRecordIndex.Add a, n
            Next
        End If
        If Not mRecordIndex.Exists(name) Then Return Nothing
        Return mRecordIndex(name)
    End Function

    Public Function FindFunction(ByVal name As String) As MSXML2.IXMLDOMElement
        If mFunctionIndex Is Nothing Then
            Set mFunctionIndex = New Collection
            mFunctionIndex.KeyCompareMode = vbBinaryCompare
            Dim f As MSXML2.IXMLDOMElement, n As String
            For Each f In Model.Functions()
                n = Model.Attr(f, "name")
                If Not mFunctionIndex.Exists(n) Then mFunctionIndex.Add f, n
            Next
        End If
        If Not mFunctionIndex.Exists(name) Then Return Nothing
        Return mFunctionIndex(name)
    End Function

    ' A typedef anywhere in the file (size_t and va_list live in CRT headers).
    Public Function FindTypedef(ByVal name As String) As MSXML2.IXMLDOMElement
        Return Model.FindElement("Typedef", name)
    End Function

    ' The library's type aliases (D-025): typedefs that rename a scalar, struct or enum (not
    ' typedef struct X X, opaque aliases, callback typedefs, or pointer-sized CRT typedefs).
    Public Function TypeAliases() As Collection
        Dim r As New Collection, td As MSXML2.IXMLDOMElement, c As TypeInfo, inner As TypeInfo, a As TypeAliasInfo
        For Each td In Model.Typedefs()
            Set c = Classify(Model.Attr(td, "id"))
            If c.AliasName = Model.Attr(td, "name") And Len(c.AliasName) > 0 Then
                Set a = New TypeAliasInfo
                a.Name = c.AliasName
                Set inner = Classify(Model.Attr(td, "type"))
                If Len(inner.AliasName) > 0 Then
                    a.Target = inner.AliasName
                ElseIf inner.Kind = "scalar" Then
                    a.Target = inner.TbType & UnsignedNote(inner.CName)
                Else
                    a.Target = inner.TbType
                End If
                a.CText = "typedef " & CTypeText(Model.Attr(td, "type")) & " " & a.Name
                Set a.Element = td
                a.HeaderPath = Model.FileOf(td)
                r.Add a
            End If
        Next
        Return r
    End Function

    ' The tB text for a classified type in a signature: the alias name when there is one.
    Private Function TypeText(c As TypeInfo) As String
        If Len(c.AliasName) > 0 Then Return c.AliasName
        If c.Kind = "scalar" Then Return c.TbType & UnsignedNote(c.CName)
        Return c.TbType
    End Function

    ' ---- outside types (D-054, D-058, D-065) ------------------------------------------------

    ' Every type declared outside the header folder that the library reaches -- through its
    ' functions, record fields and typedefs, and then through the fields of each imported struct --
    ' each once, in the order reached. Each outside name appears once (D-065: one alias per name).
    Public Function OutsideTypes() As Collection
        If Not mOutside Is Nothing Then Return mOutside
        Set mOutside = New Collection
        Set mOutsideSeen = New Collection
        mOutsideSeen.KeyCompareMode = vbBinaryCompare
        Set mOutsideNames = New Collection
        mOutsideNames.KeyCompareMode = vbBinaryCompare
        Dim el As MSXML2.IXMLDOMElement, child As MSXML2.IXMLDOMElement
        For Each el In Model.Functions()
            ReachType Model.Attr(el, "returns")
            For Each child In el.childNodes
                If child.nodeName = "Argument" Then ReachType Model.Attr(child, "type")
            Next
        Next
        For Each el In Model.Records()
            ReachFields el
        Next
        For Each el In Model.Typedefs()
            ReachType Model.Attr(el, "type")
        Next
        Return mOutside
    End Function

    Private Sub ReachFields(ByVal record As MSXML2.IXMLDOMElement)
        Dim id As Variant, f As MSXML2.IXMLDOMElement
        For Each id In Split(Trim$(Model.Attr(record, "members")), " ")
            Set f = Model.ById(id)
            If Not f Is Nothing Then
                If Model.Tag(f) = "Field" Then ReachType Model.Attr(f, "type")
            End If
        Next
    End Sub

    Private Sub ReachType(ByVal typeId As String)
        Dim e As MSXML2.IXMLDOMElement = Model.ById(typeId)
        If e Is Nothing Then Exit Sub
        Dim id As String = Model.Attr(e, "id")
        If mOutsideSeen.Exists(id) Then Exit Sub
        mOutsideSeen.Add True, id
        Dim child As MSXML2.IXMLDOMElement, t As MSXML2.IXMLDOMElement, s As MSXML2.IXMLDOMElement
        Select Case Model.Tag(e)
            Case "CvQualifiedType", "ElaboratedType", "PointerType", "ArrayType"
                ReachType Model.Attr(e, "type")
            Case "FunctionType"
                ReachType Model.Attr(e, "returns")
                For Each child In e.childNodes
                    If child.nodeName = "Argument" Then ReachType Model.Attr(child, "type")
                Next
            Case "Typedef"
                If Model.InLibrary(e) Then
                    ReachType Model.Attr(e, "type")
                ElseIf IsStdPointerType(Model.Attr(e, "name")) Then
                    AddOutside e, Model.Attr(e, "name"), "opaque"
                ElseIf IsFunctionPointerTypedef(e) Then
                    ' a callback type (FT_Alloc_Func): a delegate in its header's module (D-068)
                    AddOutside e, Model.Attr(e, "name"), "delegate"
                    ReachType Model.Attr(e, "type")
                Else
                    Set s = HandlePointee(e)
                    If Not s Is Nothing Then
                        ' the struct is imported for reading fields, unless it is incomplete or
                        ' DECLARE_HANDLE's placeholder (struct X__ { int unused; })
                        Dim o As OutsideType = AddOutside(e, Model.Attr(e, "name"), "handle")
                        If Not o Is Nothing Then
                            o.Pointee = Model.NameOf(s)
                            o.PointeeImported = Not Model.IsOpaque(s) And Not IsHandleShape(s)
                            If o.PointeeImported Then ReachType Model.Attr(s, "id")
                        End If
                    Else
                        Set t = Model.Strip(Model.Attr(e, "type"))
                        If (Model.Tag(t) = "Struct" Or Model.Tag(t) = "Union") And Model.IsOpaque(t) Then
                            ' typedef struct X Y: the alias is named after the typedef, as Classify writes it
                            AddOutside e, Model.Attr(e, "name"), "opaque"
                        Else
                            ReachType Model.Attr(e, "type")
                        End If
                    End If
                End If
            Case "Struct", "Union"
                If Model.InLibrary(e) Then
                    ReachFields e
                ElseIf IsComInterface(e) Then
                    AddOutside e, Model.NameOf(e), "com"
                ElseIf Model.IsOpaque(e) Then
                    If Len(Model.NameOf(e)) > 0 Then AddOutside e, Model.NameOf(e), "opaque"
                Else
                    AddOutside e, Model.NameOf(e), "struct"
                    ReachFields e
                End If
            Case "Enumeration"
                If Not Model.InLibrary(e) Then AddOutside e, Model.NameOf(e), "enum"
        End Select
    End Sub

    ' Records an outside type; Nothing (and nothing recorded) when its name is already taken.
    Private Function AddOutside(ByVal e As MSXML2.IXMLDOMElement, ByVal name As String, ByVal kind As String) As OutsideType
        If Len(name) = 0 Or mOutsideNames.Exists(name) Then Return Nothing
        mOutsideNames.Add True, name
        Dim o As New OutsideType
        Set o.Element = e
        o.Name = name
        o.Kind = kind
        o.HeaderPath = Model.FileOf(e)
        mOutside.Add o
        Return o
    End Function

    ' C types the C standard makes pointer-only (D-054): FILE, C11 7.21.3 (a copy of a FILE need not
    ' work in place of the original). The list grows only on the same kind of evidence.
    Private Function IsStdPointerType(ByVal name As String) As Boolean
        Return name = "FILE"
    End Function

    ' A COM interface in MIDL's C shape (D-058): a struct whose only member is lpVtbl, a pointer to
    ' a struct named <name>Vtbl.
    Public Function IsComInterface(ByVal s As MSXML2.IXMLDOMElement) As Boolean
        Dim members As String = Trim$(Model.Attr(s, "members"))
        If Len(members) = 0 Or InStr(members, " ") > 0 Then Return False
        Dim f As MSXML2.IXMLDOMElement = Model.ById(members)
        If f Is Nothing Then Return False
        If Model.Attr(f, "name") <> "lpVtbl" Then Return False
        Dim p As MSXML2.IXMLDOMElement = Model.Strip(Model.Attr(f, "type"))
        If Model.Tag(p) <> "PointerType" Then Return False
        Return Model.NameOf(Model.Strip(Model.Attr(p, "type"))) = Model.NameOf(s) & "Vtbl"
    End Function

    ' For an outside typedef of a pointer to a struct or union (HDC -> HDC__*, OUT_RECP -> OUT_REC*),
    ' that struct; Nothing otherwise, and for a COM interface pointer.
    Private Function HandlePointee(ByVal td As MSXML2.IXMLDOMElement) As MSXML2.IXMLDOMElement
        If Model.InLibrary(td) Then Return Nothing
        Dim t As MSXML2.IXMLDOMElement = Model.Strip(Model.Attr(td, "type"))
        If Model.Tag(t) <> "PointerType" Then Return Nothing
        Dim s As MSXML2.IXMLDOMElement = Model.Strip(Model.Attr(t, "type"))
        Do While Model.Tag(s) = "Typedef"
            Set s = Model.Strip(Model.Attr(s, "type"))
        Loop
        If Model.Tag(s) <> "Struct" And Model.Tag(s) <> "Union" Then Return Nothing
        If IsComInterface(s) Then Return Nothing
        Return s
    End Function

    ' ---- --pointer (D-054) -----------------------------------------------------------------

    ' True for an outside struct --pointer names, by its tag or by a typedef naming it.
    Private Function IsPointerStruct(ByVal structName As String) As Boolean
        If PointerTypes.Count = 0 Then Return False
        If mPointerStructs Is Nothing Then
            Set mPointerStructs = New Collection
            mPointerStructs.KeyCompareMode = vbBinaryCompare
            Dim n As Variant, s As String
            For Each n In PointerTypes
                s = PointerStructName(n)
                If Len(s) > 0 And Not mPointerStructs.Exists(s) Then mPointerStructs.Add True, s
            Next
        End If
        Return mPointerStructs.Exists(structName)
    End Function

    ' The outside struct a --pointer name names (its tag, or a typedef of it: LOGFONTW ->
    ' tagLOGFONTW); "" when the library uses no such struct.
    Private Function PointerStructName(ByVal name As String) As String
        Dim target As String = name
        Dim td As MSXML2.IXMLDOMElement = Model.FindElement("Typedef", name)
        If Not td Is Nothing Then
            Dim s As MSXML2.IXMLDOMElement = Model.Strip(Model.Attr(td, "type"))
            Do While Model.Tag(s) = "Typedef"
                Set s = Model.Strip(Model.Attr(s, "type"))
            Loop
            If Model.Tag(s) = "Struct" Or Model.Tag(s) = "Union" Then target = Model.NameOf(s)
        End If
        Dim o As OutsideType
        For Each o In OutsideTypes()
            If o.Kind = "struct" And o.Name = target Then Return target
        Next
        Return ""
    End Function

    ' --pointer names that name no outside struct the library uses (reported).
    Public Function UnmatchedPointerTypes() As Collection
        Dim r As New Collection, n As Variant
        For Each n In PointerTypes
            If Len(PointerStructName(n)) = 0 Then r.Add n
        Next
        Return r
    End Function

    Private Sub NotePointerUse(ByVal text As String)
        If mPointerUseKeys Is Nothing Then
            Set mPointerUseKeys = New Collection
            mPointerUseKeys.KeyCompareMode = vbBinaryCompare
        End If
        If mPointerUseKeys.Exists(text) Then Exit Sub
        mPointerUseKeys.Add True, text
        PointerUses.Add text
    End Sub

    Private Function IsFunctionPointerTypedef(ByVal td As MSXML2.IXMLDOMElement) As Boolean
        Dim t As MSXML2.IXMLDOMElement = Model.Strip(Model.Attr(td, "type"))
        If Model.Tag(t) <> "PointerType" Then Return False
        Return Model.Tag(Model.Strip(Model.Attr(t, "type"))) = "FunctionType"
    End Function

    ' ---- anonymous records (D-068) ------------------------------------------------------------

    ' A record's tB name: its own or its typedef's, else <parent>_<field> for an anonymous struct or
    ' union that is the type of a named field (cairo_path_data_t's header and point); "" when it is
    ' neither.
    Public Function RecordName(ByVal r As MSXML2.IXMLDOMElement) As String
        Dim n As String = Model.NameOf(r)
        If Len(n) > 0 Then Return n
        Dim parent As MSXML2.IXMLDOMElement = Model.ById(Model.Attr(r, "context"))
        If parent Is Nothing Then Return ""
        Dim id As Variant, f As MSXML2.IXMLDOMElement
        For Each id In Split(Trim$(Model.Attr(parent, "members")), " ")
            Set f = Model.ById(id)
            If Not f Is Nothing Then
                If Model.Tag(f) = "Field" And Len(Model.Attr(f, "name")) > 0 Then
                    If Model.Attr(FieldRecordType(f), "id") = Model.Attr(r, "id") Then
                        Dim p As String = RecordName(parent)
                        If Len(p) = 0 Then Return ""
                        Return p & "_" & Model.Attr(f, "name")
                    End If
                End If
            End If
        Next
        Return ""
    End Function

    ' A field's type with qualifiers and array dimensions stripped.
    Private Function FieldRecordType(ByVal f As MSXML2.IXMLDOMElement) As MSXML2.IXMLDOMElement
        Dim t As MSXML2.IXMLDOMElement = Model.Strip(Model.Attr(f, "type"))
        Do While Model.Tag(t) = "ArrayType"
            Set t = Model.Strip(Model.Attr(t, "type"))
        Loop
        Return t
    End Function

    ' The anonymous records RecordName names, reached from the library's records and the imported
    ' outside structs (and from each other), each once, parents first.
    Public Function AnonRecords() As Collection
        If Not mAnonRecords Is Nothing Then Return mAnonRecords
        Set mAnonRecords = New Collection
        Set mAnonSeen = New Collection
        mAnonSeen.KeyCompareMode = vbBinaryCompare
        Dim r As MSXML2.IXMLDOMElement, o As OutsideType
        For Each r In Model.Records()
            FindAnon r
        Next
        For Each o In OutsideTypes()
            If o.Kind = "struct" Then FindAnon o.Element
        Next
        Return mAnonRecords
    End Function

    Private Sub FindAnon(ByVal record As MSXML2.IXMLDOMElement)
        Dim id As Variant, f As MSXML2.IXMLDOMElement, t As MSXML2.IXMLDOMElement
        For Each id In Split(Trim$(Model.Attr(record, "members")), " ")
            Set f = Model.ById(id)
            If Not f Is Nothing Then
                If Model.Tag(f) = "Field" And Len(Model.Attr(f, "name")) > 0 Then
                    Set t = FieldRecordType(f)
                    If (Model.Tag(t) = "Struct" Or Model.Tag(t) = "Union") And Len(Model.NameOf(t)) = 0 And Not Model.IsOpaque(t) Then
                        If Not mAnonSeen.Exists(Model.Attr(t, "id")) Then
                            mAnonSeen.Add True, Model.Attr(t, "id")
                            mAnonRecords.Add t
                            FindAnon t
                        End If
                    End If
                End If
            End If
        Next
    End Sub

    ' DECLARE_HANDLE's placeholder struct: struct X__ { int unused; }.
    Private Function IsHandleShape(ByVal s As MSXML2.IXMLDOMElement) As Boolean
        If Right$(Model.NameOf(s), 2) <> "__" Then Return False
        Dim members As String = Trim$(Model.Attr(s, "members"))
        If Len(members) = 0 Or InStr(members, " ") > 0 Then Return False
        Return Model.Attr(Model.ById(members), "name") = "unused"
    End Function

    ' ---- classification ----------------------------------------------------------------

    Private Function IsPointerSizedTypedef(ByVal name As String) As Boolean
        Select Case name
            Case "size_t", "ssize_t", "intptr_t", "uintptr_t", "ptrdiff_t", "SSIZE_T", "SIZE_T", "INT_PTR", "UINT_PTR", "LONG_PTR", "ULONG_PTR"
                Return True
        End Select
        Return False
    End Function

    Private Function FundamentalTb(ByVal cname As String) As String
        Select Case cname
            Case "char", "signed char", "unsigned char", "_Bool", "bool": Return "Byte"
            Case "short int", "short unsigned int", "wchar_t", "char16_t": Return "Integer"
            Case "int", "unsigned int", "long int", "long unsigned int", "char32_t": Return "Long"
            Case "long long int", "long long unsigned int", "__int64", "unsigned __int64": Return "LongLong"
            Case "float": Return "Single"
            Case "double", "long double": Return "Double"
        End Select
        Return ""
    End Function

    Public Function Classify(ByVal typeId As String) As TypeInfo
        Dim r As New TypeInfo
        Dim e As MSXML2.IXMLDOMElement = Model.ById(typeId)
        If e Is Nothing Then
            r.Kind = "void"
            Return r
        End If
        Select Case Model.Tag(e)
            Case "CvQualifiedType", "ElaboratedType"
                Return Classify(Model.Attr(e, "type"))
            Case "Typedef"
                Dim n As String = Model.Attr(e, "name")
                If IsPointerSizedTypedef(n) Then
                    r.Kind = "scalar"
                    r.TbType = "LongPtr"
                    r.CName = n
                    Return r
                End If
                Dim t As MSXML2.IXMLDOMElement = Model.Strip(Model.Attr(e, "type"))
                ' a library typedef that renames a struct/enum/scalar is a type alias (D-025)
                Dim isAlias As Boolean = Model.InLibrary(e)
                ' D-054: an outside pointer-only type or pointer typedef is a LongPtr alias of that name
                If Not isAlias Then
                    If IsStdPointerType(n) Then
                        r.Kind = "opaque"
                        r.TbType = n
                        Return r
                    End If
                    If Not HandlePointee(e) Is Nothing Then
                        r.Kind = "handle"
                        r.TbType = n
                        Return r
                    End If
                End If
                Select Case Model.Tag(t)
                    Case "Struct", "Union"
                        Set r = RecordOrOpaque(t, n)
                        If isAlias And r.Kind = "record" And r.TbType <> n Then r.AliasName = n
                        Return r
                    Case "Enumeration"
                        r.Kind = "enum"
                        r.TbType = Model.NameOf(t)
                        If isAlias And r.TbType <> n Then r.AliasName = n
                        Return r
                    Case "PointerType"
                        If Model.Tag(Model.Strip(Model.Attr(t, "type"))) = "FunctionType" Then
                            r.Kind = "delegate"
                            r.TbType = n
                            r.Name = n
                            Return r
                        End If
                    Case "FunctionType"
                        r.Kind = "fntype"
                        r.Name = n
                        r.FnId = Model.Attr(t, "id")
                        Return r
                End Select
                Set r = Classify(Model.Attr(e, "type"))
                If r.Kind = "scalar" And (n = "wchar_t" Or n = "char16_t" Or n = "WCHAR") Then r.CName = "wchar_t (" & r.CName & ")"
                If isAlias And (r.Kind = "scalar" Or r.Kind = "record" Or r.Kind = "enum") Then
                    ' copy: r may be shared with the inner typedef's result
                    Dim a As New TypeInfo
                    a.Kind = r.Kind
                    a.TbType = r.TbType
                    a.CName = r.CName
                    a.AliasName = n
                    Return a
                End If
                Return r
            Case "FundamentalType"
                Dim cname As String = Model.Attr(e, "name")
                If cname = "void" Then
                    r.Kind = "void"
                Else
                    r.Kind = "scalar"
                    r.TbType = FundamentalTb(cname)
                    r.CName = cname
                End If
                Return r
            Case "Struct", "Union"
                Return RecordOrOpaque(e, "")
            Case "Enumeration"
                r.Kind = "enum"
                r.TbType = Model.NameOf(e)
                Return r
            Case "PointerType"
                r.Kind = "pointer"
                r.RefId = Model.Attr(e, "type")
                Return r
            Case "ArrayType"
                r.Kind = "array"
                r.RefId = Model.Attr(e, "type")
                r.ArrayMax = CLng(Val(Model.Attr(e, "max")))
                Return r
            Case "FunctionType"
                r.Kind = "fntype"
                r.FnId = Model.Attr(e, "id")
                Return r
        End Select
        r.Kind = "void"
        Return r
    End Function

    Private Function RecordOrOpaque(ByVal s As MSXML2.IXMLDOMElement, ByVal typedefName As String) As TypeInfo
        Dim r As New TypeInfo
        Dim name As String = Model.NameOf(s)
        If Not Model.InLibrary(s) And IsComInterface(s) Then
            ' D-058: only ever reached through a pointer, written LongPtr /* name */
            r.Kind = "com"
            r.TbType = name
            Return r
        End If
        If Model.IsOpaque(s) Then
            r.Kind = "opaque"
            r.TbType = IIf(Len(typedefName) > 0, typedefName, name)
        Else
            r.Kind = "record"
            r.TbType = IIf(Len(name) > 0, name, typedefName)
            If Len(r.TbType) = 0 Then r.TbType = RecordName(s)     ' anonymous, a field's type (D-068)
        End If
        Return r
    End Function

    Private Function UnsignedNote(ByVal cname As String) As String
        If InStr(cname, "unsigned") > 0 And cname <> "unsigned char" Then Return " /* unsigned */"
        Return ""
    End Function

    Private Function IsCharLike(ByVal cname As String) As Boolean
        Select Case cname
            Case "char", "signed char", "unsigned char": Return True
        End Select
        Return Left$(cname, 7) = "wchar_t"
    End Function

    ' The delegate for an unnamed function type, registered once per name.
    Private Function SynthDelegateFor(ByVal fnId As String, ByVal name As String, ByVal owner As String, Optional ByVal source As MSXML2.IXMLDOMElement = Nothing, Optional ByVal fromParam As Boolean = False) As String
        Dim s As SynthDelegate
        For Each s In SynthDelegates
            If s.Name = name Then Return name
        Next
        Set s = New SynthDelegate
        s.Name = name
        Set s.FnType = Model.ById(fnId)
        s.Owner = owner
        Set s.Source = source
        s.FromParam = fromParam
        SynthDelegates.Add s
        Return name
    End Function

    ' ---- fields ----------------------------------------------------------------------------

    ' tB type text for a field of typeId (arrays: the element type; see FieldBounds).
    Private Function FieldType(ByVal typeId As String, ByVal synthName As String, ByVal owner As String, Optional ByVal source As MSXML2.IXMLDOMElement = Nothing) As String
        Dim c As TypeInfo = Classify(typeId)
        Select Case c.Kind
            Case "scalar": Return TypeText(c)
            Case "enum", "record", "delegate": Return TypeText(c)
            Case "handle": Return c.TbType
            Case "pointer"
                Dim p As TypeInfo = Classify(c.RefId)
                If p.Kind = "fntype" Then
                    If Len(p.Name) > 0 Then Return p.Name
                    Return SynthDelegateFor(p.FnId, synthName, owner, source)
                End If
                If p.Kind = "opaque" Then Return p.TbType
                If p.Kind = "com" Then Return ComText(p.TbType)
                Return "LongPtr"
            Case "array": Return FieldType(c.RefId, synthName, owner, source)
        End Select
        Notes.Add owner & ": unexpected field type kind " & c.Kind & " (emitted as LongPtr)"
        Return "LongPtr"
    End Function

    Private Function FieldBounds(ByVal typeId As String) As String
        Dim c As TypeInfo = Classify(typeId)
        Dim b As String
        Do While c.Kind = "array"
            If Len(b) > 0 Then b &= ", "
            b &= "0 To " & c.ArrayMax
            Set c = Classify(c.RefId)
        Loop
        If Len(b) = 0 Then Return ""
        Return "(" & b & ")"
    End Function

    Private Function NewField(ByVal name As String, ByVal kind As String, ByVal typeText As String, ByVal bounds As String, ByVal offset As Long, ByVal el As MSXML2.IXMLDOMElement) As FieldInfo
        Dim f As New FieldInfo
        f.Name = name
        f.Kind = kind
        f.TypeText = typeText
        f.Bounds = bounds
        f.OffsetBytes = offset
        Set f.Element = el
        If Not el Is Nothing Then f.CText = CTypeText(Model.Attr(el, "type"))
        Return f
    End Function

    Private Function TbSizeBits(ByVal tb As String) As Long
        Select Case tb
            Case "Byte": Return 8
            Case "Integer": Return 16
            Case "Long", "Single": Return 32
            Case "LongLong", "Double": Return 64
            Case "LongPtr": Return Model.PointerSize() * 8
        End Select
        Return 32
    End Function

    ' The storage unit and element count for a union (D-018); unit "" when tB cannot express it.
    Public Function UnionUnit(ByVal u As MSXML2.IXMLDOMElement, ByRef count As Long) As String
        Dim align As Long = Model.AlignBytes(u)
        Dim size As Long = Model.SizeBytes(u)
        Dim unit As String
        If align = Model.PointerSize() And ContainsPointer(u) Then
            unit = "LongPtr"
        Else
            Select Case align
                Case 8: unit = "LongLong"
                Case 4: unit = "Long"
                Case 2: unit = "Integer"
                Case 1: unit = "Byte"
            End Select
        End If
        If Len(unit) = 0 Then Return ""
        Dim unitBytes As Long = TbSizeBits(unit) \ 8
        If size Mod unitBytes <> 0 Then Return ""
        count = size \ unitBytes
        Return unit
    End Function

    Private Function ContainsPointer(ByVal record As MSXML2.IXMLDOMElement) As Boolean
        Dim id As Variant, f As MSXML2.IXMLDOMElement, c As TypeInfo
        For Each id In Split(Model.Attr(record, "members"), " ")
            Set f = Model.ById(id)
            If Model.Tag(f) = "Field" Then
                Set c = Classify(Model.Attr(f, "type"))
                Do While c.Kind = "array"
                    Set c = Classify(c.RefId)
                Loop
                Select Case c.Kind
                    Case "pointer", "delegate", "opaque": Return True
                    Case "scalar": If c.TbType = "LongPtr" Then Return True
                    Case "record": If ContainsPointer(Model.Strip(Model.Attr(f, "type"))) Then Return True
                End Select
            End If
        Next
        Return False
    End Function

    ' Adds storage + accessors for union u placed at baseOffset; storageName names the storage.
    Private Sub AddUnion(fields As Collection, ByVal u As MSXML2.IXMLDOMElement, ByVal storageName As String, ByVal baseOffset As Long, ByVal owner As String)
        Dim count As Long
        Dim unit As String = UnionUnit(u, count)
        Dim storage As FieldInfo
        If Len(unit) = 0 Then
            Notes.Add owner & ": union cannot be expressed in tB (size " & Model.SizeBytes(u) & ", align " & Model.AlignBytes(u) & "); emitted as Byte storage"
            unit = "Byte"
            count = Model.SizeBytes(u)
        End If
        Set storage = NewField(storageName, "storage", unit, "(0 To " & (count - 1) & ")", baseOffset, Nothing)
        Dim id As Variant, f As MSXML2.IXMLDOMElement, names As String
        For Each id In Split(Model.Attr(u, "members"), " ")
            Set f = Model.ById(id)
            If Model.Tag(f) = "Field" And Len(Model.Attr(f, "name")) > 0 Then names &= IIf(Len(names) > 0, ", ", "") & Model.Attr(f, "name")
        Next
        storage.Note = "union of: " & names
        fields.Add storage
        For Each id In Split(Model.Attr(u, "members"), " ")
            Set f = Model.ById(id)
            If Model.Tag(f) = "Field" And Len(Model.Attr(f, "name")) > 0 Then
                fields.Add NewField(Model.Attr(f, "name"), "accessor", FieldType(Model.Attr(f, "type"), owner & "_" & Model.Attr(f, "name") & "_cb", owner, f), _
                    FieldBounds(Model.Attr(f, "type")), baseOffset + Model.OffsetBytes(f), f)
            End If
        Next
    End Sub

    ' The members of a struct or union, as they are to be emitted (see FieldInfo.Kind).
    Public Function FieldsOf(ByVal record As MSXML2.IXMLDOMElement) As Collection
        Dim fields As New Collection
        Dim owner As String = RecordName(record)
        If Model.Tag(record) = "Union" Then
            AddUnion fields, record, "union_data", 0, owner
            Return fields
        End If
        Dim id As Variant, f As MSXML2.IXMLDOMElement, name As String, typeId As String
        Dim units As New Collection         ' bit offset of a storage unit -> its bitfield FieldInfo
        units.KeyCompareMode = vbBinaryCompare
        Dim anon As Long
        For Each id In Split(Model.Attr(record, "members"), " ")
            Set f = Model.ById(id)
            If Model.Tag(f) <> "Field" Then GoTo NextMember
            name = Model.Attr(f, "name")
            typeId = Model.Attr(f, "type")
            If Len(Model.Attr(f, "bits")) > 0 Then
                Dim c As TypeInfo = Classify(typeId)
                Dim unitBits As Long = TbSizeBits(c.TbType)
                Dim offBits As Long = CLng(Val(Model.Attr(f, "offset")))
                Dim start As Long = (offBits \ unitBits) * unitBits
                If units.Exists(CStr(start)) Then
                    Dim prev As FieldInfo = units(CStr(start))
                    prev.Note &= " " & name & ":" & Model.Attr(f, "bits")
                Else
                    Dim bf As FieldInfo = NewField("bits_" & name, "bitfield", c.TbType & UnsignedNote(c.CName), "", start \ 8, f)
                    bf.Note = "bitfields " & name & ":" & Model.Attr(f, "bits")
                    units.Add bf, CStr(start)
                    fields.Add bf
                End If
            ElseIf Len(name) = 0 Then
                Dim inner As MSXML2.IXMLDOMElement = Model.Strip(typeId)
                If Model.Tag(inner) = "Union" Then
                    anon += 1
                    AddUnion fields, inner, "union_" & anon, Model.OffsetBytes(f), owner
                Else
                    Notes.Add owner & ": anonymous " & Model.Tag(inner) & " member at offset " & Model.OffsetBytes(f) & " not supported (skipped)"
                End If
            Else
                fields.Add NewField(name, "field", FieldType(typeId, owner & "_" & name & "_cb", owner, f), FieldBounds(typeId), Model.OffsetBytes(f), f)
            End If
NextMember:
        Next
        Return fields
    End Function

    ' ---- parameters and returns ------------------------------------------------------------

    Private Function IsVaListType(ByVal typeId As String) As Boolean
        Dim e As MSXML2.IXMLDOMElement = Model.ById(typeId)
        Do While Not e Is Nothing
            If Model.Tag(e) = "Typedef" And Model.Attr(e, "name") = "va_list" Then Return True
            Select Case Model.Tag(e)
                Case "CvQualifiedType", "ElaboratedType": Set e = Model.ById(Model.Attr(e, "type"))
                Case Else: Return False
            End Select
        Loop
        Return False
    End Function

    ' The parameters of a Function or FunctionType element.
    Public Function ParamsOf(ByVal fn As MSXML2.IXMLDOMElement) As Collection
        Dim ps As New Collection, a As MSXML2.IXMLDOMElement, i As Long, p As ParamInfo
        Dim owner As String = Model.Attr(fn, "name")
        For Each a In fn.childNodes
            If a.nodeName = "Argument" Then
                i += 1
                Set p = New ParamInfo
                p.Name = Model.Attr(a, "name")
                If Len(p.Name) = 0 Then p.Name = "arg" & i
                p.CText = CTypeText(Model.Attr(a, "type"))
                If IsVaListType(Model.Attr(a, "type")) Then
                    p.IsVaList = True
                    p.Passing = "ByRef"
                    p.TypeText = "Any()"
                Else
                    MapParam Model.Attr(a, "type"), owner & "_" & p.Name & "_cb", owner, p
                End If
                ps.Add p
            End If
        Next
        Return ps
    End Function

    Private Sub MapParam(ByVal typeId As String, ByVal synthName As String, ByVal owner As String, p As ParamInfo)
        Dim c As TypeInfo = Classify(typeId)
        p.Passing = "ByVal"
        Select Case c.Kind
            Case "scalar"
                p.TypeText = TypeText(c)
            Case "enum", "delegate"
                p.TypeText = TypeText(c)
            Case "handle"
                p.TypeText = c.TbType
            Case "record"
                p.TypeText = TypeText(c)
                p.IsStructByValue = True
            Case "fntype"
                If Len(c.Name) > 0 Then p.TypeText = c.Name Else p.TypeText = SynthDelegateFor(c.FnId, synthName, owner, Nothing, True)
            Case "pointer"
                Dim t As TypeInfo = Classify(c.RefId)
                Select Case t.Kind
                    Case "record"
                        If IsPointerStruct(t.TbType) Then
                            p.TypeText = "LongPtr"
                            NotePointerUse owner & "(" & p.Name & "): " & t.TbType & "* as LongPtr (--pointer)"
                        Else
                            p.Passing = "ByRef"
                            p.TypeText = TypeText(t)
                        End If
                    Case "opaque"
                        p.TypeText = t.TbType
                    Case "com"
                        p.TypeText = ComText(t.TbType)
                    Case "handle"
                        p.Passing = "ByRef"
                        p.TypeText = t.TbType
                    Case "fntype"
                        If Len(t.Name) > 0 Then p.TypeText = t.Name Else p.TypeText = SynthDelegateFor(t.FnId, synthName, owner, Nothing, True)
                    Case "scalar"
                        If IsCharLike(t.CName) Then
                            p.TypeText = "LongPtr"
                        Else
                            p.Passing = "ByRef"
                            p.TypeText = TypeText(t)
                        End If
                    Case "enum", "delegate"
                        p.Passing = "ByRef"
                        p.TypeText = TypeText(t)
                    Case "pointer"
                        Dim q As TypeInfo = Classify(t.RefId)
                        p.Passing = "ByRef"
                        If q.Kind = "opaque" Then
                            p.TypeText = q.TbType
                        ElseIf q.Kind = "com" Then
                            p.TypeText = ComText(q.TbType)
                        Else
                            p.TypeText = "LongPtr"
                        End If
                    Case Else
                        p.TypeText = "LongPtr"
                End Select
            Case Else
                p.TypeText = "LongPtr"
        End Select
    End Sub

    ' The tB return type of a Function or FunctionType; "" for void (a Sub).
    Public Function ReturnOf(ByVal fn As MSXML2.IXMLDOMElement) As String
        Dim c As TypeInfo = Classify(Model.Attr(fn, "returns"))
        Select Case c.Kind
            Case "void": Return ""
            Case "scalar": Return TypeText(c)
            Case "enum", "delegate", "record": Return TypeText(c)
            Case "handle": Return c.TbType
            Case "pointer"
                Dim p As TypeInfo = Classify(c.RefId)
                If p.Kind = "opaque" Then Return p.TbType
                If p.Kind = "com" Then Return ComText(p.TbType)
                Return "LongPtr"
        End Select
        Return "LongPtr"
    End Function

    ' A COM interface pointer's tB type: LongPtr, with the interface named for search (D-058).
    Private Function ComText(ByVal interfaceName As String) As String
        Return "LongPtr /* " & interfaceName & " */"
    End Function

    ' True when the function returns a struct or union by value.
    Public Function ReturnsStructByValue(ByVal fn As MSXML2.IXMLDOMElement) As Boolean
        Return Classify(Model.Attr(fn, "returns")).Kind = "record"
    End Function

    ' ---- layout ------------------------------------------------------------------------------

    ' Natural size and alignment (bytes) of a type, from CastXML.
    Private Sub SizeAlign(ByVal typeId As String, ByRef size As Long, ByRef align As Long)
        Dim e As MSXML2.IXMLDOMElement = Model.Strip(typeId)
        Select Case Model.Tag(e)
            Case "Typedef"
                SizeAlign Model.Attr(e, "type"), size, align
            Case "ArrayType"
                SizeAlign Model.Attr(e, "type"), size, align
                size = size * (CLng(Val(Model.Attr(e, "max"))) + 1)
            Case Else
                size = Model.SizeBytes(e)
                align = Model.AlignBytes(e)
                If align = 0 Then align = 1
        End Select
    End Sub

    ' Does laying the fields out with alignment capped at pack reproduce CastXML's layout?
    Private Function LayoutMatches(ByVal record As MSXML2.IXMLDOMElement, ByVal pack As Long) As Boolean
        Dim id As Variant, f As MSXML2.IXMLDOMElement, size As Long, align As Long, off As Long, maxAlign As Long
        Dim isUnion As Boolean = (Model.Tag(record) = "Union")
        Dim lastUnitStart As Long = -1
        maxAlign = 1
        For Each id In Split(Model.Attr(record, "members"), " ")
            Set f = Model.ById(id)
            If Model.Tag(f) = "Field" Then
                SizeAlign Model.Attr(f, "type"), size, align
                If align > pack Then align = pack
                If align > maxAlign Then maxAlign = align
                If Len(Model.Attr(f, "bits")) > 0 Then
                    Dim unitStart As Long = (CLng(Val(Model.Attr(f, "offset"))) \ (size * 8)) * size
                    If unitStart <> lastUnitStart Then
                        off = ((off + align - 1) \ align) * align
                        If off <> unitStart Then Return False
                        off += size
                        lastUnitStart = unitStart
                    End If
                Else
                    If isUnion Then
                        If Model.OffsetBytes(f) <> 0 Then Return False
                        If size > off Then off = size
                    Else
                        off = ((off + align - 1) \ align) * align
                        If off <> Model.OffsetBytes(f) Then Return False
                        off += size
                    End If
                End If
            End If
        Next
        off = ((off + maxAlign - 1) \ maxAlign) * maxAlign
        Return off = Model.SizeBytes(record)
    End Function

    ' 0: natural layout; n (1, 2, 4, 8): needs [PackingAlignment(n)]; -1: tB cannot express it.
    Public Function Packing(ByVal record As MSXML2.IXMLDOMElement) As Long
        If LayoutMatches(record, 1024) Then Return 0
        Dim n As Variant
        For Each n In Array(8, 4, 2, 1)
            If LayoutMatches(record, n) Then Return n
        Next
        Return -1
    End Function

    ' ---- calling convention ----------------------------------------------------------------

    ' The tB calling-convention keyword for a Function/FunctionType element of this model:
    ' "CDecl", "" (stdcall), "FastCall" or "ThisCall". Meaningful in the x86 model (x64 has one).
    Public Function CallConvOf(ByVal el As MSXML2.IXMLDOMElement) As String
        Dim a As String = " " & Model.Attr(el, "attributes") & " "
        If InStr(a, " __stdcall__ ") > 0 Then Return ""
        If InStr(a, " __fastcall__ ") > 0 Then Return "FastCall"
        If InStr(a, " __thiscall__ ") > 0 Then Return "ThisCall"
        Return "CDecl"
    End Function

    ' ---- C text for comments ----------------------------------------------------------------

    Public Function CTypeText(ByVal typeId As String) As String
        Dim e As MSXML2.IXMLDOMElement = Model.ById(typeId)
        If e Is Nothing Then Return "?"
        Select Case Model.Tag(e)
            Case "CvQualifiedType"
                Return IIf(Model.Attr(e, "const") = "1", "const ", "") & CTypeText(Model.Attr(e, "type"))
            Case "ElaboratedType"
                Return CTypeText(Model.Attr(e, "type"))
            Case "PointerType"
                Dim inner As MSXML2.IXMLDOMElement = Model.Strip(Model.Attr(e, "type"))
                If Model.Tag(inner) = "FunctionType" Then Return FnTypeText(inner)
                Return CTypeText(Model.Attr(e, "type")) & " *"
            Case "ArrayType"
                Return CTypeText(Model.Attr(e, "type")) & "[" & (CLng(Val(Model.Attr(e, "max"))) + 1) & "]"
            Case "FunctionType"
                Return FnTypeText(e)
        End Select
        Dim n As String = Model.NameOf(e)
        If Len(n) = 0 Then n = "(anonymous " & LCase$(Model.Tag(e)) & ")"
        Return n
    End Function

    Private Function FnTypeText(ByVal fn As MSXML2.IXMLDOMElement) As String
        Dim a As MSXML2.IXMLDOMElement, s As String
        For Each a In fn.childNodes
            If a.nodeName = "Argument" Then s &= IIf(Len(s) > 0, ", ", "") & CTypeText(Model.Attr(a, "type"))
            If a.nodeName = "Ellipsis" Then s &= IIf(Len(s) > 0, ", ", "") & "..."
        Next
        Return CTypeText(Model.Attr(fn, "returns")) & " (*)(" & s & ")"
    End Function

    ' ---- x86 / x64 comparison ------------------------------------------------------------------

    ' One line per way the two mappers' output differs (records, functions, unions, packing);
    ' empty when one tB source serves both architectures. Calling conventions are not compared.
    Public Function Disagreements(other As TypeMapper) As Collection
        Dim d As New Collection
        Dim r As MSXML2.IXMLDOMElement, o As MSXML2.IXMLDOMElement, f As MSXML2.IXMLDOMElement, g As MSXML2.IXMLDOMElement
        For Each r In Model.Records()
            CurrentItem = "record " & Model.NameOf(r) & " (" & Model.FileOf(r) & ":" & Model.Attr(r, "line") & ")"
            Set o = other.FindRecord(Model.NameOf(r))
            If o Is Nothing Then
                d.Add "record " & Model.NameOf(r) & " exists in only one architecture"
            Else
                CompareFields d, Model.NameOf(r), FieldsOf(r), other.FieldsOf(o)
                If Packing(r) <> other.Packing(o) Then d.Add "record " & Model.NameOf(r) & ": packing " & Packing(r) & " vs " & other.Packing(o)
            End If
        Next
        ' anonymous records named after their field are generated too (D-068)
        Dim ar As MSXML2.IXMLDOMElement
        For Each ar In AnonRecords()
            CurrentItem = "record " & RecordName(ar) & " (" & Model.FileOf(ar) & ":" & Model.Attr(ar, "line") & ")"
            Set o = other.FindRecord(RecordName(ar))
            If o Is Nothing Then
                d.Add "record " & RecordName(ar) & " exists in only one architecture"
            Else
                CompareFields d, RecordName(ar), FieldsOf(ar), other.FieldsOf(o)
            End If
        Next
        ' imported outside structs are generated too, so they must agree as well (D-054)
        Dim ot As OutsideType
        For Each ot In OutsideTypes()
            If ot.Kind = "struct" Then
                CurrentItem = "outside record " & ot.Name & " (" & ot.HeaderPath & ")"
                Set o = other.FindRecord(ot.Name)
                If o Is Nothing Then
                    d.Add "record " & ot.Name & " exists in only one architecture"
                Else
                    CompareFields d, ot.Name, FieldsOf(ot.Element), other.FieldsOf(o)
                    If Packing(ot.Element) <> other.Packing(o) Then d.Add "record " & ot.Name & ": packing " & Packing(ot.Element) & " vs " & other.Packing(o)
                End If
            End If
        Next
        For Each f In Model.Functions()
            CurrentItem = "function " & Model.Attr(f, "name") & " (" & Model.FileOf(f) & ":" & Model.Attr(f, "line") & ")"
            Set g = other.FindFunction(Model.Attr(f, "name"))
            If g Is Nothing Then
                d.Add "function " & Model.Attr(f, "name") & " exists in only one architecture"
            Else
                Dim a As String = SignatureText(f)
                Dim b As String = other.SignatureText(g)
                If a <> b Then d.Add "function " & Model.Attr(f, "name") & "(...): " & a & " vs " & b
            End If
        Next
        CurrentItem = ""
        Return d
    End Function

    Private Sub CompareFields(d As Collection, ByVal record As String, a As Collection, b As Collection)
        Dim i As Long
        If a.Count <> b.Count Then
            d.Add "record " & record & ": " & a.Count & " vs " & b.Count & " members"
            Exit Sub
        End If
        For i = 1 To a.Count
            Dim x As FieldInfo = a(i)
            Dim y As FieldInfo = b(i)
            If x.Name <> y.Name Or x.Kind <> y.Kind Or x.TypeText <> y.TypeText Or x.Bounds <> y.Bounds Then
                d.Add record & "." & x.Name & ": " & x.Kind & " " & x.TypeText & x.Bounds & " vs " & y.Kind & " " & y.TypeText & y.Bounds
            End If
        Next
    End Sub

    ' "ret(ByVal T, ByRef U, ...)" -- what the Declare would look like, without names.
    Public Function SignatureText(ByVal fn As MSXML2.IXMLDOMElement) As String
        Dim p As ParamInfo, s As String
        For Each p In ParamsOf(fn)
            s &= IIf(Len(s) > 0, ", ", "") & IIf(p.IsVaList, "va_list", p.Passing & " " & p.TypeText)
        Next
        If Model.HasEllipsis(fn) Then s &= IIf(Len(s) > 0, ", ", "") & "..."
        Return ReturnOf(fn) & "(" & s & ")"
    End Function
End Class
