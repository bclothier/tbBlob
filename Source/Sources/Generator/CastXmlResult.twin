' What RunCastXml produced: the five output files, and on failure the exit code and why.
Class CastXmlResult
    Public Xml86Path As String
    Public Xml64Path As String
    Public Macros86Path As String    ' macro dump of the x86 compiler (D-030)
    Public Macros64Path As String
    Public Preprocessed64Path As String  ' the headers as the x64 compiler preprocesses them (D-060)
    Public ExitCode As Long
    Public ErrorText As String
End Class
