' Finds castxml.exe and the MSVC environment, and runs the four CastXML passes (x86 XML, x64
' XML, x86 and x64 macro dumps -- D-030; the x64 one also preprocesses the headers, D-060)
' through .cmd scripts written to the work folder (D-017). PRD req. 5-9.
Module CastXmlRunner
    ' The 0xC0000135 (STATUS_DLL_NOT_FOUND) exit code of a program Windows could not start.
    Public Const STATUS_DLL_NOT_FOUND As Long = &HC0000135

    ' castxml.exe: argPath if given (and it must exist), else envValue (the CASTXML variable),
    ' else the CastXML bundled next to tbBlob (<exeDir>\castxml\bin\castxml.exe, D-035), else the
    ' first PATH folder that holds castxml.exe; "" when none is found.
    Public Function FindCastXmlIn(ByVal argPath As String, ByVal envValue As String, ByVal exeDir As String, ByVal pathValue As String) As String
        Dim folder As Variant, candidate As String
        If Len(argPath) > 0 Then
            If FileSys.KindOf(argPath) = FileSys.KIND_FILE Then Return argPath
            Return ""
        End If
        If Len(envValue) > 0 Then
            If FileSys.KindOf(envValue) = FileSys.KIND_FILE Then Return envValue
        End If
        If Len(exeDir) > 0 Then
            candidate = BundledCastXml(exeDir)
            If FileSys.KindOf(candidate) = FileSys.KIND_FILE Then Return candidate
        End If
        For Each folder In Split(pathValue, ";")
            folder = Trim$(folder)
            If Len(folder) > 0 Then
                If Right$(folder, 1) = "\" Then candidate = folder & "castxml.exe" Else candidate = folder & "\castxml.exe"
                If FileSys.KindOf(candidate) = FileSys.KIND_FILE Then Return candidate
            End If
        Next
        Return ""
    End Function

    ' FindCastXmlIn with the real CASTXML and PATH variables.
    Public Function FindCastXml(ByVal argPath As String) As String
        Return FindCastXmlIn(argPath, Environ$("CASTXML"), App.Path, Environ$("PATH"))
    End Function

    ' Where a CastXML bundled with tbBlob lives (tools\package.ps1 puts it there).
    Public Function BundledCastXml(ByVal exeDir As String) As String
        Return exeDir & "\castxml\bin\castxml.exe"
    End Function

    ' A header castxml.exe needs from its own share folder (clang's resource headers): it looks
    ' for them at ..\share\castxml\clang\include next to its bin folder.
    Public Function ResourceHeaderPath(ByVal castxml As String) As String
        Return FileSys.ParentOf(FileSys.ParentOf(castxml)) & "\share\castxml\clang\include\stddef.h"
    End Function

    ' True when path starts with a Windows executable header (MZ, then PE at e_lfanew). Checked
    ' before running castxml.exe: running a file that is not a program (empty, truncated) makes
    ' Windows show a "This app can't run on your PC" dialog instead of failing quietly.
    Public Function LooksLikeProgram(ByVal path As String) As Boolean
        If FileSys.KindOf(path) <> FileSys.KIND_FILE Then Return False
        Dim f As Integer = FreeFile
        Dim b(0 To 1023) As Byte
        On Error GoTo failed
        Open path For Binary Access Read As #f
        If LOF(f) < 1024 Then
            Close #f
            Return False
        End If
        Get #f, 1, b
        Close #f
        If b(0) <> &H4D Or b(1) <> &H5A Then Return False
        Dim pe As Long = CLng(b(60)) + CLng(b(61)) * &H100& + CLng(b(62)) * &H10000
        If pe < 64 Or pe > 1020 Then Return False
        Return b(pe) = &H50 And b(pe + 1) = &H45 And b(pe + 2) = 0 And b(pe + 3) = 0
    failed:
        Close #f
        Return False
    End Function

    ' What a castxml exit code means when it is not CastXML's own failure; "" otherwise.
    Public Function ExplainExit(ByVal code As Long) As String
        If code = STATUS_DLL_NOT_FOUND Then
            Return "castxml.exe could not start because a DLL it needs is missing (the MSVC runtime): install the " & _
                "Microsoft Visual C++ Redistributable 2015-2022 (x64), https://aka.ms/vs/17/release/vc_redist.x64.exe"
        End If
        Return ""
    End Function

    ' The Visual Studio / Build Tools folder that has the C++ tools, from vswhere; "" if none.
    Public Function FindVsPath(Optional ByVal vswhere As String = "") As String
        If Len(vswhere) = 0 Then vswhere = Doctor.VswherePath()
        If FileSys.KindOf(vswhere) <> FileSys.KIND_FILE Then Return ""
        If Tools.RunCommand(Tools.Quote(vswhere) & " -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64 -property installationPath") <> 0 Then Return ""
        Dim lines() As String = Split(Replace(Tools.LastToolOutput, vbCr, ""), vbLf)
        Return Trim$(lines(0))
    End Function

    ' vcvars32.bat (arch "x86") or vcvars64.bat (arch "x64") under vsPath; "" if missing.
    Public Function FindVcvarsIn(ByVal vsPath As String, ByVal arch As String) As String
        If Len(vsPath) = 0 Then Return ""
        Dim path As String = vsPath & "\VC\Auxiliary\Build\vcvars" & IIf(arch = "x86", "32", "64") & ".bat"
        If FileSys.KindOf(path) = FileSys.KIND_FILE Then Return path
        Return ""
    End Function

    ' The text of Work\tbblob_entry.h: #include of the entry header, then of each --also header.
    ' Forward slashes: MSVC and clang accept them, and they need no escaping in a #include.
    Public Function EntryFileText(ByVal entryHeader As String, alsoHeaders As Collection) As String
        Dim s As String = "/* GENERATED by tbBlob: the entry header, then each --also header (D-033). */" & vbCrLf
        s &= "#include """ & Replace(entryHeader, "\", "/") & """" & vbCrLf
        Dim h As Variant
        For Each h In alsoHeaders
            s &= "#include """ & Replace(h, "\", "/") & """" & vbCrLf
        Next
        Return s
    End Function

    ' The .cmd script for one pass: calls vcvars, then castxml. macros = True gives the -E -dM
    ' macro dump; else the XML (--castxml-output=1). castxml's arguments are quoted by the C
    ' runtime's rules (QuoteArg, D-056), the vcvars call by cmd's; one -I per include folder
    ' (the header folder first), one -D per define. With preprocessedPath, a macro pass also
    ' writes the preprocessed headers there, in the same vcvars environment (D-060).
    Public Function BuildScript(ByVal vcvars As String, ByVal castxml As String, ByVal headerFolder As String, includeDirs As Collection, defines As Collection, ByVal entryHeader As String, ByVal outPath As String, ByVal macros As Boolean, Optional ByVal preprocessedPath As String = "") As String
        Dim flags As String, v As Variant
        flags = " -I " & Tools.QuoteArg(headerFolder)
        For Each v In includeDirs
            flags &= " -I " & Tools.QuoteArg(v)
        Next
        For Each v In defines
            flags &= " -D " & Tools.QuoteArg(v)
        Next
        Dim cx As String = Tools.QuoteArg(castxml) & " --castxml-cc-msvc-c cl"
        Dim entry As String = " " & Tools.QuoteArg(entryHeader)
        Dim s As String = "@call " & Tools.Quote(vcvars) & " >nul 2>nul" & vbCrLf
        If macros Then
            ' -o goes with the other options; -E -dM must come first.
            s &= cx & " -E -dM -o " & Tools.QuoteArg(outPath) & flags & entry
            If Len(preprocessedPath) > 0 Then
                ' -std=c11: in its default C mode, castxml -E rejects the // comments on the SDK's
                ' #if lines (sal.h). It defines no __STDC_VERSION__ (MSVC's C has none), so the
                ' headers preprocess as in the other passes.
                s &= " || exit /b 1" & vbCrLf & cx & " -E -std=c11 -o " & Tools.QuoteArg(preprocessedPath) & flags & entry
            End If
        Else
            s &= cx & " --castxml-output=1" & flags & " -o " & Tools.QuoteArg(outPath) & entry
        End If
        Return s & vbCrLf
    End Function

    ' Runs the four passes (XML and macro dump, x86 and x64, D-030; the x64 macro pass also writes the preprocessed headers, D-060) for o into workFolder (created if missing). vsPathOverride replaces
    ' vswhere's answer (tests). ExitCode: 0 ok, 1 castxml failed, 4 castxml or MSVC not found.
    Public Function RunCastXml(o As CliOptions, ByVal workFolder As String, Optional ByVal vsPathOverride As String = "") As CastXmlResult
        Dim r As New CastXmlResult
        Dim castxml As String = FindCastXml(o.CastXmlPath)
        If Len(castxml) = 0 Then
            r.ExitCode = MainModule.EXIT_TOOL_NOT_FOUND
            r.ErrorText = "castxml.exe not found (looked at --castxml, the CASTXML variable, castxml\bin\castxml.exe next to tbBlob.exe, then PATH)" & IIf(Len(o.CastXmlPath) > 0, ": " & o.CastXmlPath, "")
            Return r
        End If
        Dim vs As String = vsPathOverride
        If Len(vs) = 0 Then vs = FindVsPath()
        Dim vc32 As String = FindVcvarsIn(vs, "x86")
        Dim vc64 As String = FindVcvarsIn(vs, "x64")
        If Len(vc32) = 0 Or Len(vc64) = 0 Then
            r.ExitCode = MainModule.EXIT_TOOL_NOT_FOUND
            If Len(vs) = 0 And FileSys.KindOf(Doctor.VswherePath()) <> FileSys.KIND_FILE Then
                r.ErrorText = "Visual Studio not found: " & Doctor.VswherePath() & " does not exist -- install Visual Studio 2022 or the Build Tools for Visual Studio 2022 with the 'Desktop development with C++' workload (tbBlob --check lists every dependency)"
            Else
                r.ErrorText = "MSVC vcvars not found (vcvars32.bat and vcvars64.bat under '" & vs & "\VC\Auxiliary\Build') -- install Visual Studio or the Build Tools with the 'Desktop development with C++' workload (tbBlob --check lists every dependency)"
            End If
            Return r
        End If
        Dim resource As String = ResourceHeaderPath(castxml)
        If FileSys.KindOf(resource) <> FileSys.KIND_FILE Then
            r.ExitCode = MainModule.EXIT_TOOL_NOT_FOUND
            r.ErrorText = "CastXML's resource headers not found: " & FileSys.ParentOf(resource) & " -- castxml.exe needs the share\castxml folder that comes with it; keep CastXML's bin and share folders together (tbBlob --check lists every dependency)"
            Return r
        End If
        If Not LooksLikeProgram(castxml) Then
            r.ExitCode = MainModule.EXIT_TOOL_NOT_FOUND
            r.ErrorText = castxml & " is not a valid program (no Windows executable header; empty or damaged?) -- reinstall CastXML (tbBlob --check lists every dependency)"
            Return r
        End If

        FileSys.MakeDirs workFolder
        Dim work As String = FileSys.FullPath(workFolder)
        Dim headerFolder As String = FileSys.FullPath(o.HeaderFolder)
        r.Xml86Path = work & "\castxml_x86.xml"
        r.Xml64Path = work & "\castxml_x64.xml"
        r.Macros86Path = work & "\macros_x86.txt"
        r.Macros64Path = work & "\macros_x64.txt"
        r.Preprocessed64Path = work & "\preprocessed_x64.i"
        ' D-057: when a pass fails only because of --also headers, they are dropped and every pass
        ' runs again (both architectures, so one source serves both); each round drops at least one
        Dim also As New Collection, names As Collection, failing As Collection, full As Collection
        Dim h As Variant, entry As String, pass As String, output As String, attempt As Long, s As SkippedHeader
        For Each h In o.AlsoHeaders
            also.Add h
        Next
        Do
            attempt += 1
            entry = FileSys.JoinPath(headerFolder, o.EntryHeader)
            If also.Count > 0 Then
                ' D-033: CastXML takes one input file, so the entry header and the --also headers go in one
                Set full = New Collection
                For Each h In also
                    full.Add FileSys.JoinPath(headerFolder, h)
                Next
                FileSys.WriteTextUtf8 work & "\tbblob_entry.h", EntryFileText(entry, full)
                entry = work & "\tbblob_entry.h"
            End If
            pass = RunPasses(r, vc32, vc64, castxml, headerFolder, o, entry, work)
            If Len(pass) = 0 Or also.Count = 0 Then Return r
            Set names = New Collection
            names.Add o.EntryHeader
            For Each h In also
                names.Add h
            Next
            output = Tools.LastToolOutput
            Set failing = FailingHeaders(output, entry, names)
            If failing.Count = 0 Or Contains(failing, o.EntryHeader) Then Return r
            AppendText work & "\castxml_" & pass & "_failed.txt", output
            For Each h In failing
                Set s = New SkippedHeader
                s.Header = h
                s.Pass = pass
                Set s.ErrorLines = ErrorLinesFor(output, entry, names, h)
                r.SkippedHeaders.Add s
                RemoveItem also, h
            Next
            r.ExitCode = 0
            r.ErrorText = ""
        Loop
    End Function

    ' The four passes for entry; "" when all succeeded, else the name of the pass that failed (r
    ' then says why, and Tools.LastToolOutput holds CastXML's output).
    Private Function RunPasses(r As CastXmlResult, ByVal vc32 As String, ByVal vc64 As String, ByVal castxml As String, ByVal headerFolder As String, o As CliOptions, ByVal entry As String, ByVal work As String) As String
        If Not RunPass(r, "x86", BuildScript(vc32, castxml, headerFolder, o.IncludeDirs, o.Defines, entry, r.Xml86Path, False), work, r.Xml86Path) Then Return "x86"
        If Not RunPass(r, "x64", BuildScript(vc64, castxml, headerFolder, o.IncludeDirs, o.Defines, entry, r.Xml64Path, False), work, r.Xml64Path) Then Return "x64"
        If Not RunPass(r, "macros_x86", BuildScript(vc32, castxml, headerFolder, o.IncludeDirs, o.Defines, entry, r.Macros86Path, True), work, r.Macros86Path) Then Return "macros_x86"
        If Not RunPass(r, "macros_x64", BuildScript(vc64, castxml, headerFolder, o.IncludeDirs, o.Defines, entry, r.Macros64Path, True, r.Preprocessed64Path), work, r.Macros64Path, r.Preprocessed64Path) Then Return "macros_x64"
        Return ""
    End Function

    Private Function Contains(c As Collection, ByVal text As String) As Boolean
        Dim v As Variant
        For Each v In c
            If v = text Then Return True
        Next
        Return False
    End Function

    Private Sub RemoveItem(c As Collection, ByVal text As String)
        Dim i As Long
        For i = c.Count To 1 Step -1
            If c(i) = text Then c.Remove i
        Next
    End Sub

    Private Sub AppendText(ByVal path As String, ByVal text As String)
        Dim prior As String
        If FileSys.KindOf(path) = FileSys.KIND_FILE Then prior = FileSys.ReadTextUtf8(path) & vbCrLf
        FileSys.WriteTextUtf8 path, prior & text
    End Sub

    ' ---- tracing errors to --also headers (D-057) --------------------------------------------

    ' The headers a failed pass's errors trace back to, each once: names(1) is the entry header,
    ' then the --also headers, as entryFile (tbblob_entry.h) includes them from line 2 on (line 1 is
    ' its comment). Empty when any error does not trace to one of them -- an error in entryFile
    ' itself, a CastXML error with no file, or one with no include frame: skipping headers would not
    ' explain that failure. Warnings are ignored.
    Public Function FailingHeaders(ByVal errorText As String, ByVal entryFile As String, names As Collection) As Collection
        Dim r As New Collection, e As Variant
        For Each e In TraceErrors(errorText, entryFile, names)
            If Len(e(0)) = 0 Then Return New Collection
            If Not Contains(r, e(0)) Then r.Add e(0)
        Next
        Return r
    End Function

    ' CastXML's error lines that trace back to header (see FailingHeaders).
    Public Function ErrorLinesFor(ByVal errorText As String, ByVal entryFile As String, names As Collection, ByVal header As String) As Collection
        Dim r As New Collection, e As Variant
        For Each e In TraceErrors(errorText, entryFile, names)
            If e(0) = header Then r.Add e(1)
        Next
        Return r
    End Function

    ' Array(header or "", error line) for each error. clang prints a diagnostic's include stack
    ' outermost first ("In file included from <file>:<line>:"), and leaves it out when the previous
    ' diagnostic came from the same file.
    Private Function TraceErrors(ByVal errorText As String, ByVal entryFile As String, names As Collection) As Collection
        Dim r As New Collection
        Dim lines() As String = Split(Replace(errorText, vbCr, ""), vbLf)
        Dim i As Long, s As String, file As String, lastFile As String
        Dim outermost As String, framed As String, inFrames As Boolean
        For i = 0 To UBound(lines)
            s = lines(i)
            If Left$(s, 22) = "In file included from " Then
                If Not inFrames Then framed = Mid$(s, 23)
                inFrames = True
            ElseIf DiagnosticFile(s, file) Then
                If inFrames Then
                    outermost = framed
                ElseIf LCase$(file) <> LCase$(lastFile) Then
                    outermost = ""      ' no stack: the compiled file itself
                End If
                inFrames = False
                lastFile = file
                If InStr(s, ": error: ") > 0 Or InStr(s, ": fatal error: ") > 0 Then r.Add Array(HeaderOfFrame(outermost, entryFile, names), s)
            ElseIf Left$(s, 7) = "error: " Or Left$(s, 13) = "fatal error: " Then
                r.Add Array("", s)      ' CastXML's own error, no file
            End If
        Next
        Return r
    End Function

    ' True for a diagnostic line, "<file>:<line>:<column>: <kind>: <text>", with its file.
    Private Function DiagnosticFile(ByVal s As String, ByRef file As String) As Boolean
        Dim kind As Variant, p As Long
        For Each kind In Array(": fatal error: ", ": error: ", ": warning: ", ": note: ")
            p = InStr(s, kind)
            If p > 0 Then Exit For
        Next
        If p = 0 Then Return False
        Dim head As String = Left$(s, p - 1)
        Dim c2 As Long = InStrRev(head, ":")
        If c2 = 0 Then Return False
        Dim c1 As Long = InStrRev(head, ":", c2 - 1)
        If c1 = 0 Then Return False
        If Not (Mid$(head, c1 + 1, c2 - c1 - 1) Like "#*") Or Not (Mid$(head, c2 + 1) Like "#*") Then Return False
        file = Left$(head, c1 - 1)
        Return True
    End Function

    ' The header that line n of entryFile includes, from a frame "<entryFile>:<n>:"; "" when the
    ' frame is in another file or names no included header.
    Private Function HeaderOfFrame(ByVal frame As String, ByVal entryFile As String, names As Collection) As String
        If Len(frame) = 0 Then Return ""
        If Right$(frame, 1) = ":" Then frame = Left$(frame, Len(frame) - 1)
        Dim c As Long = InStrRev(frame, ":")
        If c = 0 Then Return ""
        If LCase$(FileSys.BaseName(Left$(frame, c - 1))) <> LCase$(FileSys.BaseName(entryFile)) Then Return ""
        Dim n As Long = CLng(Val(Mid$(frame, c + 1)))
        If n < 2 Or n - 1 > names.Count Then Return ""
        Return names(n - 1)
    End Function

    ' Writes and runs castxml_<name>.cmd; False (with r filled in) when castxml failed or did not
    ' write outPath (and outPath2, when given).
    Private Function RunPass(r As CastXmlResult, ByVal name As String, ByVal script As String, ByVal work As String, ByVal outPath As String, Optional ByVal outPath2 As String = "") As Boolean
        Dim scriptPath As String = work & "\castxml_" & name & ".cmd"
        FileSys.WriteTextUtf8 scriptPath, script
        If FileSys.KindOf(outPath) = FileSys.KIND_FILE Then FileSys.RemovePath outPath
        If Len(outPath2) > 0 Then
            If FileSys.KindOf(outPath2) = FileSys.KIND_FILE Then FileSys.RemovePath outPath2
        End If
        Dim code As Long = Tools.RunCommand(Tools.Quote(scriptPath))
        Dim written As Boolean = FileSys.KindOf(outPath) = FileSys.KIND_FILE
        If Len(outPath2) > 0 Then written = written And FileSys.KindOf(outPath2) = FileSys.KIND_FILE
        If code = 0 And written Then Return True
        r.ExitCode = MainModule.EXIT_FAILED
        r.ErrorText = "castxml failed (" & name & " pass, exit " & code & "; script " & scriptPath & "):" & vbLf & Tools.LastToolOutput
        If Len(ExplainExit(code)) > 0 Then r.ErrorText &= vbLf & ExplainExit(code)
        Return False
    End Function
End Module
