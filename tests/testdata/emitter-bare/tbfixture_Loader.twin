' Calling it is optional. Without it, the declares bind to tbfixture.dll on the first call through
' the Windows DLL search order: the process's EXE folder, the system folders, the current
' folder, then PATH -- never subfolders. Call Load or LoadFile before the first call to use a
' DLL from elsewhere; every Lib "tbfixture.dll" declare then binds to the module already loaded.
Module tbfixture_Loader
    Private Declare PtrSafe Function LoadLibraryExW Lib "kernel32" (ByVal lpLibFileName As LongPtr, ByVal hFile As LongPtr, ByVal dwFlags As Long) As LongPtr
    Private Declare PtrSafe Function GetModuleHandleW Lib "kernel32" (ByVal lpModuleName As LongPtr) As LongPtr
    Private Declare PtrSafe Function GetFileAttributesW Lib "kernel32" (ByVal lpFileName As LongPtr) As Long
    ' The DLL's own dependencies are looked for in its folder first.
    Private Const LOAD_WITH_ALTERED_SEARCH_PATH As Long = 8
    Private Const LOAD_FAILED As Long = vbObjectError + &H2701
    Private Const DLL_NAME As String = "tbfixture.dll"
    #If Win64 Then
        Private Const ARCH_DIR As String = "win64"
    #Else
        Private Const ARCH_DIR As String = "win32"
    #End If

    ' Loads folder\win32\tbfixture.dll or folder\win64\tbfixture.dll (matching the running code) when
    ' that file exists, else folder\tbfixture.dll. Returns the module handle. Raises an error naming
    ' every path tried when it cannot load; an architecture file that exists but fails to load is
    ' not passed over for folder\tbfixture.dll (that could be the other architecture's DLL).
    Public Function Load(ByVal folder As String) As LongPtr
        Do While Len(folder) > 0 And (Right$(folder, 1) = "\" Or Right$(folder, 1) = "/")
            folder = Left$(folder, Len(folder) - 1)
        Loop
        Dim archPath As String = folder & "\" & ARCH_DIR & "\" & DLL_NAME
        Dim flatPath As String = folder & "\" & DLL_NAME
        Dim h As LongPtr, tried As String
        If GetFileAttributesW(StrPtr(archPath)) <> -1 Then
            h = LoadLibraryExW(StrPtr(archPath), 0, LOAD_WITH_ALTERED_SEARCH_PATH)
            If h <> 0 Then Return h
            tried = archPath & " (Windows error " & Err.LastDllError & ")"
        Else
            tried = archPath & " (not found); "
            If GetFileAttributesW(StrPtr(flatPath)) <> -1 Then
                h = LoadLibraryExW(StrPtr(flatPath), 0, LOAD_WITH_ALTERED_SEARCH_PATH)
                If h <> 0 Then Return h
                tried &= flatPath & " (Windows error " & Err.LastDllError & ")"
            Else
                tried &= flatPath & " (not found)"
            End If
        End If
        Err.Raise LOAD_FAILED, , "cannot load " & DLL_NAME & ": tried " & tried
    End Function

    ' Loads tbfixture.dll from one full path. Returns the module handle; raises an error naming
    ' the path when it cannot load.
    Public Function LoadFile(ByVal path As String) As LongPtr
        Dim h As LongPtr = LoadLibraryExW(StrPtr(path), 0, LOAD_WITH_ALTERED_SEARCH_PATH)
        If h = 0 Then Err.Raise LOAD_FAILED, , "cannot load " & DLL_NAME & ": tried " & path & " (Windows error " & Err.LastDllError & ")"
        Return h
    End Function

    ' True when a module named tbfixture.dll is loaded in this process.
    Public Function IsLoaded() As Boolean
        Return GetModuleHandleW(StrPtr(DLL_NAME)) <> 0
    End Function
