    Private Function T_TBF_LAYOUT_ENTRY(ByVal member As String) As Long
        Dim v As TBF_LAYOUT_ENTRY
        Select Case member
            Case "": Return LenB(v)
            Case "record": Return CLng(VarPtr(v.record) - VarPtr(v))
            Case "field": Return CLng(VarPtr(v.field) - VarPtr(v))
            Case "value": Return CLng(VarPtr(v.value) - VarPtr(v))
        End Select
        Return -1
    End Function

    Public Function LayoutMismatches() As String
        mOut = ""
        L_TBF_SCALARS
        L_TBF_POINT
        L_tbf_late
        L_TBF_S4
        L_TBF_S8
        L_TBF_S16
        L_TBF_S24
        L_TBF_RECT
        L_TBF_CALLBACKS
        L_TBF_VALUE
        L_TBF_TAGGED
        L_TBF_ANON
        L_TBF_FLAGS
        L_TBF_PACKED1
        L_TBF_PACKED2
        L_TBF_SIZED
        L_tbf_closed
        L_TBF_KEYWORDS
        L_tbf_buf
        L_TBF_LAYOUT_ENTRY
        Return mOut
    End Function
End Module
