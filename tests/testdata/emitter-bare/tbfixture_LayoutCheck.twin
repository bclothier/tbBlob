' GENERATED by tbBlob: expected sizes and offsets from CastXML (x86, x64). Do not edit.
' LayoutMismatches() returns "" when every generated Type matches C, else one line per mismatch.
Module tbfixture_LayoutCheck
    Private mOut As String

    Private Function E(ByVal x86 As Long, ByVal x64 As Long) As Long
        #If Win64 Then
            Return x64
        #Else
            Return x86
        #End If
    End Function

    Private Sub Chk(ByVal what As String, ByVal actual As Long, ByVal expected As Long)
        If actual <> expected Then mOut &= what & ": " & actual & " <> " & expected & vbLf
    End Sub

    Private Sub L_TBF_SCALARS()
        Dim v As TBF_SCALARS
        Chk "TBF_SCALARS size", LenB(v), E(72, 88)
        Chk "TBF_SCALARS.c", CLng(VarPtr(v.c) - VarPtr(v)), E(0, 0)
        Chk "TBF_SCALARS.sc", CLng(VarPtr(v.sc) - VarPtr(v)), E(1, 1)
        Chk "TBF_SCALARS.uc", CLng(VarPtr(v.uc) - VarPtr(v)), E(2, 2)
        Chk "TBF_SCALARS.s", CLng(VarPtr(v.s) - VarPtr(v)), E(4, 4)
        Chk "TBF_SCALARS.us", CLng(VarPtr(v.us) - VarPtr(v)), E(6, 6)
        Chk "TBF_SCALARS.i", CLng(VarPtr(v.i) - VarPtr(v)), E(8, 8)
        Chk "TBF_SCALARS.ui", CLng(VarPtr(v.ui) - VarPtr(v)), E(12, 12)
        Chk "TBF_SCALARS.l", CLng(VarPtr(v.l) - VarPtr(v)), E(16, 16)
        Chk "TBF_SCALARS.ul", CLng(VarPtr(v.ul) - VarPtr(v)), E(20, 20)
        Chk "TBF_SCALARS.ll", CLng(VarPtr(v.ll) - VarPtr(v)), E(24, 24)
        Chk "TBF_SCALARS.ull", CLng(VarPtr(v.ull) - VarPtr(v)), E(32, 32)
        Chk "TBF_SCALARS.f", CLng(VarPtr(v.f) - VarPtr(v)), E(40, 40)
        Chk "TBF_SCALARS.d", CLng(VarPtr(v.d) - VarPtr(v)), E(48, 48)
        Chk "TBF_SCALARS.b", CLng(VarPtr(v.b) - VarPtr(v)), E(56, 56)
        Chk "TBF_SCALARS.z", CLng(VarPtr(v.z) - VarPtr(v)), E(60, 64)
        Chk "TBF_SCALARS.ip", CLng(VarPtr(v.ip) - VarPtr(v)), E(64, 72)
        Chk "TBF_SCALARS.wc", CLng(VarPtr(v.wc) - VarPtr(v)), E(68, 80)
    End Sub

    Private Sub L_TBF_POINT()
        Dim v As TBF_POINT
        Chk "TBF_POINT size", LenB(v), E(8, 8)
        Chk "TBF_POINT.x", CLng(VarPtr(v.x) - VarPtr(v)), E(0, 0)
        Chk "TBF_POINT.y", CLng(VarPtr(v.y) - VarPtr(v)), E(4, 4)
    End Sub

