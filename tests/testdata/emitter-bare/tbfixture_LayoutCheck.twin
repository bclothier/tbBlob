    End Sub

    Private Sub L_TBF_PACKED2()
        Dim v As TBF_PACKED2
        Chk "TBF_PACKED2 size", LenB(v), E(14, 14)
        Chk "TBF_PACKED2.c", CLng(VarPtr(v.c) - VarPtr(v)), E(0, 0)
        Chk "TBF_PACKED2.i", CLng(VarPtr(v.i) - VarPtr(v)), E(2, 2)
