        Dim v As TBF_ANON
        Select Case member
            Case "": Return LenB(v)
            Case "kind": Return CLng(VarPtr(v.kind) - VarPtr(v))
            Case "as_int": Return CLng(VarPtr(v.union_1(0)) - VarPtr(v)) + 0
            Case "as_float": Return CLng(VarPtr(v.union_1(0)) - VarPtr(v)) + 0
        End Select
        Return -1
    End Function

