    Private Function T_TBF_KEYWORDS(ByVal member As String) As Long
        Dim v As TBF_KEYWORDS
        Select Case member
            Case "": Return LenB(v)
            Case "type": Return CLng(VarPtr(v.type) - VarPtr(v))
            Case "local": Return CLng(VarPtr(v.local) - VarPtr(v))
            Case "end": Return CLng(VarPtr(v.end) - VarPtr(v))
            Case "next": Return CLng(VarPtr(v.next) - VarPtr(v))
            Case "option": Return CLng(VarPtr(v.option) - VarPtr(v))
            Case "object": Return CLng(VarPtr(v.object) - VarPtr(v))
