            Case "b": Return CLng(VarPtr(v.b) - VarPtr(v))
            Case "c": Return CLng(VarPtr(v.c) - VarPtr(v))
        End Select
        Return -1
    End Function

    Private Function T_TBF_RECT(ByVal member As String) As Long
        Dim v As TBF_RECT
        Select Case member
            Case "": Return LenB(v)
            Case "tl": Return CLng(VarPtr(v.tl) - VarPtr(v))
            Case "br": Return CLng(VarPtr(v.br) - VarPtr(v))
            Case "name": Return CLng(VarPtr(v.name(0)) - VarPtr(v))
            Case "weights": Return CLng(VarPtr(v.weights(0)) - VarPtr(v))
        End Select
        Return -1
    End Function

    Private Function T_TBF_CALLBACKS(ByVal member As String) As Long
        Dim v As TBF_CALLBACKS
        Select Case member
            Case "": Return LenB(v)
            Case "version": Return CLng(VarPtr(v.version) - VarPtr(v))
            Case "visit": Return CLng(VarPtr(v.visit) - VarPtr(v))
            Case "visit_std": Return CLng(VarPtr(v.visit_std) - VarPtr(v))
            Case "notify": Return CLng(VarPtr(v.notify) - VarPtr(v))
            Case "context": Return CLng(VarPtr(v.context) - VarPtr(v))
        End Select
        Return -1
    End Function

    Private Function T_TBF_VALUE(ByVal member As String) As Long
        Dim v As TBF_VALUE
        Select Case member
            Case "": Return LenB(v)
            Case "i": Return CLng(VarPtr(v.union_data(0)) - VarPtr(v)) + 0
            Case "d": Return CLng(VarPtr(v.union_data(0)) - VarPtr(v)) + 0
            Case "bytes": Return CLng(VarPtr(v.union_data(0)) - VarPtr(v)) + 0
        End Select
        Return -1
    End Function

