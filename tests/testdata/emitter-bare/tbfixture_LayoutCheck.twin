        Chk "TBF_CALLBACKS size", LenB(v), E(20, 40)
        Chk "TBF_CALLBACKS.version", CLng(VarPtr(v.version) - VarPtr(v)), E(0, 0)
        Chk "TBF_CALLBACKS.visit", CLng(VarPtr(v.visit) - VarPtr(v)), E(4, 8)
        Chk "TBF_CALLBACKS.visit_std", CLng(VarPtr(v.visit_std) - VarPtr(v)), E(8, 16)
        Chk "TBF_CALLBACKS.notify", CLng(VarPtr(v.notify) - VarPtr(v)), E(12, 24)
        Chk "TBF_CALLBACKS.context", CLng(VarPtr(v.context) - VarPtr(v)), E(16, 32)
