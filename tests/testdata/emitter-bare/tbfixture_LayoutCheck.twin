        Chk "TBF_S24.b", CLng(VarPtr(v.b) - VarPtr(v)), E(8, 8)
        Chk "TBF_S24.c", CLng(VarPtr(v.c) - VarPtr(v)), E(16, 16)
    End Sub

    Private Sub L_TBF_RECT()
        Dim v As TBF_RECT
        Chk "TBF_RECT size", LenB(v), E(48, 48)
        Chk "TBF_RECT.tl", CLng(VarPtr(v.tl) - VarPtr(v)), E(0, 0)
        Chk "TBF_RECT.br", CLng(VarPtr(v.br) - VarPtr(v)), E(8, 8)
        Chk "TBF_RECT.name", CLng(VarPtr(v.name(0)) - VarPtr(v)), E(16, 16)
        Chk "TBF_RECT.weights", CLng(VarPtr(v.weights(0)) - VarPtr(v)), E(24, 24)
    End Sub

    Private Sub L_TBF_CALLBACKS()
