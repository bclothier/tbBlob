    Private Sub L_tbf_closed()
        Dim v As tbf_closed
        Chk "tbf_closed size", LenB(v), E(4, 4)
        Chk "tbf_closed.code", CLng(VarPtr(v.code) - VarPtr(v)), E(0, 0)
    End Sub

    Private Sub L_TBF_KEYWORDS()
        Dim v As TBF_KEYWORDS
        Chk "TBF_KEYWORDS size", LenB(v), E(32, 32)
        Chk "TBF_KEYWORDS.type", CLng(VarPtr(v.type) - VarPtr(v)), E(0, 0)
        Chk "TBF_KEYWORDS.local", CLng(VarPtr(v.local) - VarPtr(v)), E(4, 4)
        Chk "TBF_KEYWORDS.end", CLng(VarPtr(v.end) - VarPtr(v)), E(8, 8)
        Chk "TBF_KEYWORDS.next", CLng(VarPtr(v.next) - VarPtr(v)), E(12, 12)
        Chk "TBF_KEYWORDS.option", CLng(VarPtr(v.option) - VarPtr(v)), E(16, 16)
        Chk "TBF_KEYWORDS.object", CLng(VarPtr(v.object) - VarPtr(v)), E(20, 20)
        Chk "TBF_KEYWORDS.string", CLng(VarPtr(v.string) - VarPtr(v)), E(24, 24)
        Chk "TBF_KEYWORDS.date", CLng(VarPtr(v.date) - VarPtr(v)), E(28, 28)
    End Sub

    Private Sub L_tbf_buf()
        Dim v As tbf_buf
        Chk "tbf_buf size", LenB(v), E(12, 24)
        Chk "tbf_buf.ptr", CLng(VarPtr(v.ptr) - VarPtr(v)), E(0, 0)
        Chk "tbf_buf.reserved", CLng(VarPtr(v.reserved) - VarPtr(v)), E(4, 8)
        Chk "tbf_buf.size", CLng(VarPtr(v.size) - VarPtr(v)), E(8, 16)
    End Sub

    Private Sub L_TBF_LAYOUT_ENTRY()
        Dim v As TBF_LAYOUT_ENTRY
        Chk "TBF_LAYOUT_ENTRY size", LenB(v), E(12, 24)
        Chk "TBF_LAYOUT_ENTRY.record", CLng(VarPtr(v.record) - VarPtr(v)), E(0, 0)
        Chk "TBF_LAYOUT_ENTRY.field", CLng(VarPtr(v.field) - VarPtr(v)), E(4, 8)
        Chk "TBF_LAYOUT_ENTRY.value", CLng(VarPtr(v.value) - VarPtr(v)), E(8, 16)
    End Sub

    ' TbLayout(record, "") = tB's LenB of the Type for C record `record`; TbLayout(record, member) =
    ' tB's offset of that C member; -1 when unknown (no such record/member, bitfield, over-aligned).
    Public Function TbLayout(ByVal record As String, ByVal member As String) As Long
        Select Case record
            Case "TBF_SCALARS": Return T_TBF_SCALARS(member)
            Case "TBF_POINT": Return T_TBF_POINT(member)
            Case "tbf_late": Return T_tbf_late(member)
            Case "TBF_S4": Return T_TBF_S4(member)
            Case "TBF_S8": Return T_TBF_S8(member)
            Case "TBF_S16": Return T_TBF_S16(member)
            Case "TBF_S24": Return T_TBF_S24(member)
            Case "TBF_RECT": Return T_TBF_RECT(member)
            Case "TBF_CALLBACKS": Return T_TBF_CALLBACKS(member)
            Case "TBF_VALUE": Return T_TBF_VALUE(member)
            Case "TBF_TAGGED": Return T_TBF_TAGGED(member)
            Case "TBF_ANON": Return T_TBF_ANON(member)
            Case "TBF_FLAGS": Return T_TBF_FLAGS(member)
            Case "TBF_PACKED1": Return T_TBF_PACKED1(member)
            Case "TBF_PACKED2": Return T_TBF_PACKED2(member)
            Case "TBF_SIZED": Return T_TBF_SIZED(member)
            Case "tbf_closed": Return T_tbf_closed(member)
            Case "TBF_KEYWORDS": Return T_TBF_KEYWORDS(member)
            Case "tbf_buf": Return T_tbf_buf(member)
            Case "TBF_LAYOUT_ENTRY": Return T_TBF_LAYOUT_ENTRY(member)
        End Select
        Return -1
    End Function

    Private Function T_TBF_SCALARS(ByVal member As String) As Long
        Dim v As TBF_SCALARS
        Select Case member
            Case "": Return LenB(v)
            Case "c": Return CLng(VarPtr(v.c) - VarPtr(v))
            Case "sc": Return CLng(VarPtr(v.sc) - VarPtr(v))
            Case "uc": Return CLng(VarPtr(v.uc) - VarPtr(v))
            Case "s": Return CLng(VarPtr(v.s) - VarPtr(v))
            Case "us": Return CLng(VarPtr(v.us) - VarPtr(v))
            Case "i": Return CLng(VarPtr(v.i) - VarPtr(v))
            Case "ui": Return CLng(VarPtr(v.ui) - VarPtr(v))
            Case "l": Return CLng(VarPtr(v.l) - VarPtr(v))
            Case "ul": Return CLng(VarPtr(v.ul) - VarPtr(v))
            Case "ll": Return CLng(VarPtr(v.ll) - VarPtr(v))
            Case "ull": Return CLng(VarPtr(v.ull) - VarPtr(v))
            Case "f": Return CLng(VarPtr(v.f) - VarPtr(v))
            Case "d": Return CLng(VarPtr(v.d) - VarPtr(v))
            Case "b": Return CLng(VarPtr(v.b) - VarPtr(v))
            Case "z": Return CLng(VarPtr(v.z) - VarPtr(v))
            Case "ip": Return CLng(VarPtr(v.ip) - VarPtr(v))
            Case "wc": Return CLng(VarPtr(v.wc) - VarPtr(v))
        End Select
        Return -1
    End Function

    Private Function T_TBF_POINT(ByVal member As String) As Long
        Dim v As TBF_POINT
        Select Case member
            Case "": Return LenB(v)
            Case "x": Return CLng(VarPtr(v.x) - VarPtr(v))
            Case "y": Return CLng(VarPtr(v.y) - VarPtr(v))
        End Select
        Return -1
    End Function

    Private Function T_tbf_late(ByVal member As String) As Long
        Dim v As tbf_late
        Select Case member
            Case "": Return LenB(v)
            Case "value": Return CLng(VarPtr(v.value) - VarPtr(v))
        End Select
        Return -1
    End Function

